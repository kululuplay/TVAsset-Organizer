# Pinned inputs for the Media3 FFmpeg audio decoder extension build.
# Sourced by scripts/ffmpeg/build_media3_ffmpeg.sh and by the
# `ffmpeg-extension` job in .github/workflows/android.yml (cache key).
#
# MEDIA3_VERSION must equal the androidx.media3 version declared in
# IptvPlayer/app/build.gradle.kts; the build script refuses a mismatch because
# an extension AAR compiled against another media3 line breaks at runtime.
MEDIA3_VERSION=1.11.1
# FFmpeg release tag (LGPL default configuration, no --enable-gpl/nonfree).
# libraries/decoder_ffmpeg/README.md at media3 1.11.1 still recommends release/6.0.
FFMPEG_TAG=n6.0.1
# NDK r26b: the version the media3 1.11.1 README documents as tested.
NDK_VERSION=26.1.10909125
# CMake required by libraries/decoder_ffmpeg/src/main/jni/CMakeLists.txt (3.21+).
CMAKE_VERSION=3.22.1
# Lowest platform level for the native code (must not exceed the app minSdk).
ANDROID_ABI_LEVEL=23
# FFmpeg decoders compiled into libffmpegJNI.so (audio only).
ENABLED_DECODERS="mp3 mp2 aac ac3 eac3 dca opus vorbis flac alac mlp truehd"
