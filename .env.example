# Crash receiver (required)
DATABASE_URL=postgres://user:password@localhost:5432/kululu
CRASH_INGEST_KEY=replace-with-a-long-random-value
ADMIN_USER=admin
ADMIN_PASSWORD=replace-with-a-long-random-password

# Android build integrations (optional; blank disables the feature)
TELEMETRY_INGEST_KEY=
TMDB_API_KEY=

# Optional crash forwarding
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional playback policy fallback (JSON; the panel's "Oynatma politikası"
# section overrides it once saved). Schema: docs/playback-policy.md
PLAYBACK_POLICY_JSON=

# Playback policy signing (docs/policy-signing.md). PKCS#8 PEM of a P-256 key,
# generated by scripts/generate_policy_keys.py; multi-line or with literal \n.
# Unset = only the unsigned playbackPolicy is served (new apps fail closed).
POLICY_SIGNING_PRIVATE_KEY_PEM=
POLICY_SIGNING_KID=1

# Release health gate (docs/release-health.md). Shared with the GitHub Actions
# secret of the same name; unset = GET /api/release-health answers 503.
RELEASE_HEALTH_KEY=

# Retention (days; 0 disables). QoE session summaries default to 60.
RETENTION_QOE_DAYS=60
