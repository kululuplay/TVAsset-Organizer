<?xml version="1.0" encoding="utf-8"?>
<!-- Selectable request-type chip: brand-pink fill when selected, dark glass when
     not. A white ring when focused-and-selected and a pink ring when focused-only
     keep the D-pad position obvious on a 10-foot screen. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_pink" />
            <corners android:radius="@dimen/badge_radius" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_pink" />
            <corners android:radius="@dimen/badge_radius" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card_focused" />
            <corners android:radius="@dimen/badge_radius" />
            <stroke android:width="@dimen/focus_stroke" android:color="@color/brand_pink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_card" />
            <corners android:radius="@dimen/badge_radius" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
