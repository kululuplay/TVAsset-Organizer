<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary action pill (Trailer / favorite): dark glass, white focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_input_focused" />
            <corners android:radius="@dimen/badge_radius" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_input_focused" />
            <corners android:radius="@dimen/badge_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#66101820" />
            <corners android:radius="@dimen/badge_radius" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
