<?xml version="1.0" encoding="utf-8"?>
<!-- Edge-lit cinematic backdrop that keeps the center quiet for poster art. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_cinematic" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.04"
                android:centerY="0.04"
                android:gradientRadius="740dp"
                android:startColor="#527B2FF7"
                android:endColor="#007B2FF7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.96"
                android:centerY="0.86"
                android:gradientRadius="780dp"
                android:startColor="#3D22D3EE"
                android:endColor="#0022D3EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00101820"
                android:centerColor="#33101820"
                android:endColor="#B307090F" />
        </shape>
    </item>
</layer-list>
