<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom scrim over the Live TV preview so the channel caption stays legible
     over bright video. Dark at the bottom, fading to transparent upward. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#F00E1216"
        android:endColor="#000E1216"
        android:type="linear" />
</shape>
