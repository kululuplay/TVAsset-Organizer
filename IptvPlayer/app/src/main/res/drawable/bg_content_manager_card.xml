<?xml version="1.0" encoding="utf-8"?>
<!-- TV-first hub card: restrained at rest, unmistakable under D-pad focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <gradient
                android:angle="0"
                android:startColor="@color/brand_blue"
                android:endColor="@color/brand_purple" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <gradient
                android:angle="0"
                android:startColor="#F23A6BFF"
                android:endColor="#ECA23BF0" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <gradient
                android:angle="135"
                android:startColor="#E6232C3A"
                android:endColor="#D9151A23" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
