<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic series browser backdrop with restrained pink/violet depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_cinematic" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.08"
                android:centerY="0.18"
                android:gradientRadius="720dp"
                android:startColor="#42FF2E9A"
                android:endColor="#00FF2E9A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.90"
                android:centerY="0.88"
                android:gradientRadius="900dp"
                android:startColor="#333A6BFF"
                android:endColor="#003A6BFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="#16000000"
                android:endColor="#8A000000" />
        </shape>
    </item>
</layer-list>
