<?xml version="1.0" encoding="utf-8"?>
<!-- Primary action pill (Play): light fill, dark content, accent focus ring. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/text_primary" />
            <corners android:radius="@dimen/badge_radius" />
            <stroke android:width="3dp" android:color="@color/accent" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D6DBE2" />
            <corners android:radius="@dimen/badge_radius" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/text_primary" />
            <corners android:radius="@dimen/badge_radius" />
        </shape>
    </item>
</selector>
