<?xml version="1.0" encoding="utf-8"?>
<!-- Trailing "Edit" pill on a content-manager tile. Glass by default; lights up
     with the brand gradient when its parent tile is focused (the pill carries
     android:duplicateParentState="true" so it follows the row's focus state). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <gradient
                android:angle="0"
                android:startColor="@color/brand_purple"
                android:endColor="@color/brand_pink"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="100dp" />
            <solid android:color="@color/glass_input" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
