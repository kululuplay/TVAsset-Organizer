<?xml version="1.0" encoding="utf-8"?>
<!-- Preview surface: a restrained cinema gradient behind video and artwork. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="22dp" />
    <gradient
        android:angle="315"
        android:startColor="#17263A"
        android:centerColor="#141827"
        android:endColor="#241231"
        android:type="linear" />
    <stroke android:width="1dp" android:color="#2EFFFFFF" />
</shape>
