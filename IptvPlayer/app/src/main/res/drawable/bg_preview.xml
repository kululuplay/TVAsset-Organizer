<?xml version="1.0" encoding="utf-8"?>
<!-- Live preview surface: a dark purple-tinted gradient with rounded corners,
     used behind the focused channel logo until playback opens. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/tile_radius" />
    <gradient
        android:angle="135"
        android:startColor="#241834"
        android:centerColor="#1A1426"
        android:endColor="#10101C"
        android:type="linear" />
    <stroke android:width="1dp" android:color="@color/glass_stroke" />
</shape>
