<?xml version="1.0" encoding="utf-8"?>
<!--
  Kululu IPTV launcher icon. Self-contained two-tone tile + brand mark.
  Uses only FLAT fills (no vector gradient) so it renders reliably on API 21+
  where the system draws the icon with the framework VectorDrawable.
  Full-bleed square (the system applies its own mask).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Base (brand purple) -->
    <path
        android:fillColor="#7B2FF7"
        android:pathData="M0,0h108v108h-108z" />
    <!-- Diagonal magenta wedge (top-right to bottom-left split) -->
    <path
        android:fillColor="#FF2E9A"
        android:pathData="M108,0 L108,108 L0,108 Z" />
    <!-- Subtle blue depth band along the diagonal -->
    <path
        android:fillColor="#3A6BFF"
        android:fillAlpha="0.22"
        android:pathData="M108,30 L108,108 L18,108 Z" />
    <!-- Play triangle -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M40,33 L40,75 C40,77.6 42.8,79.2 45,77.8 L78,56.8 C80.1,55.4 80.1,52.6 78,51.2 L45,30.2 C42.8,28.8 40,30.4 40,33 Z" />
    <!-- Inner broadcast arc -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M83,42 A13,13 0 0 1 83,66" />
    <!-- Outer broadcast arc -->
    <path
        android:strokeColor="#FFFFFF"
        android:strokeAlpha="0.85"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M90,33 A22,22 0 0 1 90,75" />
</vector>
