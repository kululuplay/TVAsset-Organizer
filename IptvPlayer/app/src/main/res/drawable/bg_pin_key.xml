<?xml version="1.0" encoding="utf-8"?>
<!-- High-contrast TV keypad state; focus remains obvious from viewing distance. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="#F05E6FE8" />
            <stroke android:width="2dp" android:color="@android:color/white" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <gradient
                android:angle="0"
                android:endColor="@color/settings_row_focus_end"
                android:startColor="@color/settings_row_focus_start" />
            <stroke
                android:width="@dimen/focus_stroke"
                android:color="@color/settings_row_focus_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="#B81B2432" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_surface_stroke" />
        </shape>
    </item>
</selector>
