<?xml version="1.0" encoding="utf-8"?>
<!-- Focus remains dark and luminous instead of becoming a bright white slab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/live_row_focused" />
            <stroke android:width="2dp" android:color="@color/live_stroke_focused" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/live_row_selected" />
            <stroke android:width="1dp" android:color="@color/live_stroke_selected" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="@color/live_row" />
            <stroke android:width="1dp" android:color="#0FFFFFFF" />
        </shape>
    </item>
</selector>
