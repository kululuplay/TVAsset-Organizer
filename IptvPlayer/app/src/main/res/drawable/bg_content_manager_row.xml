<?xml version="1.0" encoding="utf-8"?>
<!-- Dense but readable manager row. Selected is reserved for move mode. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/badge_radius" />
            <gradient
                android:angle="0"
                android:startColor="#F23A6BFF"
                android:endColor="#ECA23BF0" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/badge_radius" />
            <gradient
                android:angle="0"
                android:startColor="#E63A6BFF"
                android:endColor="#D98B5CF6" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/badge_radius" />
            <solid android:color="#70263F7A" />
            <stroke android:width="2dp" android:color="@color/brand_pink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/badge_radius" />
            <gradient
                android:angle="135"
                android:startColor="#D91D2633"
                android:endColor="#C9141922" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
