<?xml version="1.0" encoding="utf-8"?>
<!-- Thin accent divider under the content-manager header: a brand hairline that
     fades in from transparent, peaks pink, and fades back out to transparent. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="0"
        android:startColor="#00FF5FB0"
        android:centerColor="#66FF5FB0"
        android:endColor="#003A6BFF"
        android:type="linear" />
    <corners android:radius="2dp" />
</shape>
