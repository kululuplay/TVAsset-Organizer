<?xml version="1.0" encoding="utf-8"?>
<!-- Circular top-bar action button: subtle glass by default, filled highlight
     when focused/pressed for clear D-pad feedback. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <solid android:color="@color/brand_magenta" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/brand_magenta" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/glass_input" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
