<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="0"
                android:startColor="#5A123E52"
                android:endColor="#4A30205F" />
            <stroke
                android:width="2dp"
                android:color="@color/live_cyan" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#34243A71" />
            <stroke
                android:width="1dp"
                android:color="@color/live_violet" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#16FFFFFF" />
            <stroke
                android:width="1dp"
                android:color="#14FFFFFF" />
        </shape>
    </item>
</selector>
