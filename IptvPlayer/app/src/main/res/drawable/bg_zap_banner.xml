<?xml version="1.0" encoding="utf-8"?>
<!-- Channel info / zap banner background: vertical gradient, ~80% opaque black at
     the bottom fading to transparent at the top so text stays readable over live
     video. angle=90 puts startColor at the bottom. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/overlay_scrim"
        android:centerColor="#99000000"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>
