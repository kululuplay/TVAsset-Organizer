<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic login backdrop: near-black base with a magenta glow top-start,
     a blue glow bottom-end and a subtle bottom vignette for depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_cinematic" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.16"
                android:centerY="0.22"
                android:gradientRadius="760dp"
                android:startColor="#73FF2E9A"
                android:endColor="#00FF2E9A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.92"
                android:centerY="0.96"
                android:gradientRadius="860dp"
                android:startColor="#5E3A6BFF"
                android:endColor="#003A6BFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.5"
                android:centerY="0.42"
                android:gradientRadius="520dp"
                android:startColor="#357B2FF7"
                android:endColor="#007B2FF7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:centerColor="#00000000"
                android:endColor="#99000000" />
        </shape>
    </item>
</layer-list>
