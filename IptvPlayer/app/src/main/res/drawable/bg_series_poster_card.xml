<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="315"
                android:startColor="#D5331C49"
                android:endColor="#E01A2F63" />
            <stroke
                android:width="3dp"
                android:color="@color/brand_pink" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <solid android:color="#663A6BFF" />
            <stroke
                android:width="2dp"
                android:color="@color/brand_purple" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="18dp" />
            <gradient
                android:angle="270"
                android:startColor="#E51B2230"
                android:endColor="#E3121721" />
            <stroke
                android:width="1dp"
                android:color="#28FFFFFF" />
        </shape>
    </item>
</selector>
