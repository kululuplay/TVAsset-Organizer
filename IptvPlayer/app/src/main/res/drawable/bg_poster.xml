<?xml version="1.0" encoding="utf-8"?>
<!-- Poster card background. A bright brand ring remains obvious from a sofa,
     while the translucent fill keeps artwork visually dominant. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="#24FFFFFF" />
            <stroke android:width="3dp" android:color="@color/brand_pink" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@color/glass_input" />
            <stroke android:width="1dp" android:color="#7B2FF7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@color/glass_input" />
        </shape>
    </item>
</selector>
