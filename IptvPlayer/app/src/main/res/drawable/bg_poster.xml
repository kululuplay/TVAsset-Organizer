<?xml version="1.0" encoding="utf-8"?>
<!-- Poster card background. Focused = purple stroke + translucent purple fill,
     selected = subtle stroke, default = glass. Matches the Live TV row accent. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="#332E9A" />
            <stroke android:width="@dimen/focus_stroke" android:color="#7B2FF7" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@color/glass_input" />
            <stroke android:width="1dp" android:color="#7B2FF7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@color/glass_input" />
        </shape>
    </item>
</selector>
