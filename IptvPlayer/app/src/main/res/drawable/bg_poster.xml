<?xml version="1.0" encoding="utf-8"?>
<!-- Layered catalog surface: cyan is the transient D-pad focus, violet is a
     persistent selection, and the quiet glass outline keeps unfocused posters
     visually grouped without competing with artwork. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <gradient
                android:angle="315"
                android:endColor="#3822D3EE"
                android:startColor="#448B5CF6" />
            <stroke
                android:width="3dp"
                android:color="@color/accent_cyan" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="#241E293B" />
            <stroke
                android:width="2dp"
                android:color="@color/live_violet" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="#B8151B26" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
