<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded brand monolith used instead of the older generic circular badge. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="30dp" />
    <gradient
        android:angle="135"
        android:startColor="@color/brand_magenta"
        android:centerColor="@color/brand_purple"
        android:endColor="@color/brand_blue" />
    <stroke android:width="1dp" android:color="#80FFFFFF" />
</shape>
