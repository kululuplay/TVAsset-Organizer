<?xml version="1.0" encoding="utf-8"?>
<!-- Premium launch canvas: near-black base, a controlled brand glow behind the
     mark and a cool edge glow that gives widescreen TVs visual depth. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#03050A"
                android:centerColor="#080D17"
                android:endColor="#06121A" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.30"
                android:centerY="0.50"
                android:gradientRadius="430dp"
                android:startColor="#5CFF2E9A"
                android:centerColor="#247B2FF7"
                android:endColor="#007B2FF7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="radial"
                android:centerX="0.96"
                android:centerY="0.10"
                android:gradientRadius="620dp"
                android:startColor="#2D22D3EE"
                android:endColor="#0022D3EE" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#00000000"
                android:endColor="#70000000" />
        </shape>
    </item>
</layer-list>
