<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#E63A6BFF"
                android:endColor="#E67B2FF7" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#993A6BFF"
                android:endColor="#997B2FF7" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="@color/brand_pink" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#26FFFFFF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="2dp"
                android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#0FFFFFFF" />
            <corners android:radius="16dp" />
            <stroke
                android:width="1dp"
                android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
