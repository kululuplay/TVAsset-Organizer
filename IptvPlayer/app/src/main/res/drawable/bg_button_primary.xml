<?xml version="1.0" encoding="utf-8"?>
<!-- Primary CTA: magenta-to-purple gradient. Focus brightens to pink + white ring
     for clear 10-foot feedback; pressed dims to solid purple. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/brand_pink"
                android:endColor="@color/brand_magenta" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/brand_purple" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/brand_magenta"
                android:endColor="@color/brand_purple" />
            <corners android:radius="16dp" />
        </shape>
    </item>
</selector>
