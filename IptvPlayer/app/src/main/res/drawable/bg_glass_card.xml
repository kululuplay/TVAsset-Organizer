<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted-glass sign-in card: translucent dark fill, soft rounded corners and
     a faint hairline stroke that reads as a premium surface over the aurora. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/glass_card" />
    <corners android:radius="24dp" />
    <stroke android:width="1dp" android:color="@color/glass_stroke" />
</shape>
