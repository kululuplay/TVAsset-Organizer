<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#F2455DC7"
                android:endColor="#F28B3FE6" />
            <corners android:radius="14dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#D93C4B88" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#B81A2230" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="#3AFFFFFF" />
        </shape>
    </item>
</selector>
