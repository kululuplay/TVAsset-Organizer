<?xml version="1.0" encoding="utf-8"?>
<!-- High-contrast TV focus treatment: cyan outer line, subtle white lift and a
     pink inner accent. It stays visible on both dark and colourful cards. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <corners android:radius="@dimen/tile_radius" />
                    <solid android:color="#16FFFFFF" />
                    <stroke android:width="3dp" android:color="@color/accent_cyan" />
                </shape>
            </item>
            <item
                android:left="5dp"
                android:top="5dp"
                android:right="5dp"
                android:bottom="5dp">
                <shape android:shape="rectangle">
                    <corners android:radius="15dp" />
                    <stroke android:width="1dp" android:color="#99FF5FB0" />
                    <solid android:color="@android:color/transparent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/tile_radius" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
