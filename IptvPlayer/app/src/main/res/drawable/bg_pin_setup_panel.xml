<?xml version="1.0" encoding="utf-8"?>
<!-- Settings PIN editor, visually separated from parental-control toggles. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/tile_radius" />
    <gradient
        android:angle="90"
        android:endColor="#C9171F2D"
        android:startColor="#D3222B3E" />
    <stroke
        android:width="1dp"
        android:color="#3D8AA4FF" />
</shape>
