<?xml version="1.0" encoding="utf-8"?>
<!-- Category / channel row background. Focused = solid purple highlight, selected
     = translucent purple with stroke, default = subtle glass. Keeps the D-pad
     cursor obvious on a 10-foot UI. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <gradient
                android:angle="0"
                android:startColor="#7B2FF7"
                android:endColor="#9D4EDD"
                android:type="linear" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="#332E9A" />
            <stroke android:width="1dp" android:color="#7B2FF7" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="@color/glass_input" />
        </shape>
    </item>
</selector>
