<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV hero tile: purple to amber cinematic gradient. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="@dimen/tile_radius" />
    <gradient
        android:angle="0"
        android:startColor="#7C3AED"
        android:centerColor="#A8553E"
        android:endColor="#E0A53B"
        android:type="linear" />
</shape>
