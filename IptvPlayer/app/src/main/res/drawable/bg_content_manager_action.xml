<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary header action. A full white ring stays legible on every TV. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/badge_radius" />
            <gradient
                android:angle="0"
                android:startColor="@color/brand_blue"
                android:endColor="@color/brand_purple" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/badge_radius" />
            <gradient
                android:angle="0"
                android:startColor="@color/brand_blue"
                android:endColor="@color/brand_purple" />
            <stroke android:width="3dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/badge_radius" />
            <solid android:color="@color/glass_input" />
            <stroke android:width="1dp" android:color="@color/glass_stroke" />
        </shape>
    </item>
</selector>
