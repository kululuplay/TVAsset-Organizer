<?xml version="1.0" encoding="utf-8"?>
<!-- Settings row / selectable tile. Focused or selected = solid white (the active
     row in the reference), default = dark glass navy. Pairs with the
     @color/settings_row_text color selector so the label flips to dark on focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="#16202E" />
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
        </shape>
    </item>
</selector>
