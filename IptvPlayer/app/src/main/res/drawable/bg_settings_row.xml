<?xml version="1.0" encoding="utf-8"?>
<!-- Focus is bright and transient; selection is a calmer persistent blue state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="@color/settings_row_surface" />
            <stroke android:width="1dp" android:color="@color/settings_surface_stroke" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <gradient
                android:angle="0"
                android:endColor="@color/settings_row_focus_end"
                android:startColor="@color/settings_row_focus_start" />
            <stroke
                android:width="@dimen/focus_stroke"
                android:color="@color/settings_row_focus_stroke" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="@color/settings_row_selected" />
            <stroke
                android:width="1dp"
                android:color="@color/settings_row_selected_stroke" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <solid android:color="@color/settings_row_surface" />
            <stroke android:width="1dp" android:color="@color/settings_surface_stroke" />
        </shape>
    </item>
</selector>
