<?xml version="1.0" encoding="utf-8"?>
<!-- TV home-screen banner (320x180dp aspect). Branded Kululu IPTV tile. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="@color/brand_purple"
                android:endColor="@color/brand_magenta" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center"
        android:drawable="@drawable/ic_kululu_logo" />
</layer-list>
