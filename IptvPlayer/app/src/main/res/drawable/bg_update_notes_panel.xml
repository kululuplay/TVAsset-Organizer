<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#F0222938"
                android:endColor="#F0171D2A" />
            <corners android:radius="16dp" />
            <stroke android:width="2dp" android:color="@color/brand_pink" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#EB171E2A"
                android:endColor="#EB10151E" />
            <corners android:radius="16dp" />
            <stroke android:width="1dp" android:color="#30FFFFFF" />
        </shape>
    </item>
</selector>
