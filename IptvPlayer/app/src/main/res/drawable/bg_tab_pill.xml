<?xml version="1.0" encoding="utf-8"?>
<!-- Segmented pill tab. Active tab gets the brand gradient; focus adds a ring so
     the remote cursor stays visible even on the active tab. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/brand_magenta"
                android:endColor="@color/brand_purple" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="@color/brand_magenta"
                android:endColor="@color/brand_purple" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/glass_input_focused" />
            <corners android:radius="12dp" />
            <stroke android:width="2dp" android:color="@color/brand_magenta" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
