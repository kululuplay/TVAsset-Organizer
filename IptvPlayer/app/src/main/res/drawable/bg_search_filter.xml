<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#FF3A6BFF"
                android:endColor="#FF9B3DE4" />
            <corners android:radius="13dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#E632466F" />
            <corners android:radius="13dp" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#D93A6BFF"
                android:endColor="#D9863EE4" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#80FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#A81A2230" />
            <corners android:radius="13dp" />
            <stroke android:width="1dp" android:color="#38FFFFFF" />
        </shape>
    </item>
</selector>
