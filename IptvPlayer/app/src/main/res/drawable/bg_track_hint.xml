<?xml version="1.0" encoding="utf-8"?>
<!-- Transient "languages / subtitles available" banner pill shown for a few
     seconds when playback starts. Translucent dark panel + glass stroke. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#E6161B22" />
    <corners android:radius="@dimen/badge_radius" />
    <stroke android:width="1dp" android:color="@color/glass_stroke" />
</shape>
