<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="@color/brand_blue" android:endColor="@color/brand_magenta" />
            <stroke android:width="4dp" android:color="@color/text_primary" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/accent_dim" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <gradient android:angle="45" android:startColor="@color/brand_blue" android:endColor="@color/brand_magenta" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
        </shape>
    </item>
</selector>
