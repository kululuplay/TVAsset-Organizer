<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Require TLS by default. The fixed Xtream endpoint is the only service
         that still needs cleartext HTTP compatibility. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">kululu.live</domain>
    </domain-config>
</network-security-config>
