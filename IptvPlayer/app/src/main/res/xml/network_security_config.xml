<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPTV portals frequently redirect to HTTP subdomains, CDN hosts or raw IP
         addresses. Permit those user-supplied playback/login endpoints so Media3
         and libVLC follow the same network policy. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <!-- ISRG Root X1 (Let's Encrypt). Android 7.0 and 7.1.0 do not ship
                 it, so the portal certificate was rejected on e.g. 2015 Sony
                 BRAVIA sets (login error NET-TLS). Android 6.0 ignores this file
                 and gets the same root in code (BundledRootTrust). -->
            <certificates src="@raw/isrg_root_x1" />
        </trust-anchors>
    </base-config>

    <!-- App-owned hosts never need HTTP: update metadata and APKs (GitHub),
         the rollout policy (raw.githubusercontent.com), the crash/heartbeat
         receiver (Replit) and the Kululu portal. A downgraded or redirected
         plain-HTTP request to any of them fails instead of leaking data. -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">github.com</domain>
        <domain includeSubdomains="true">githubusercontent.com</domain>
        <domain includeSubdomains="false">asset-organizer-kululuaydin.replit.app</domain>
        <domain includeSubdomains="true">kululu.live</domain>
    </domain-config>
</network-security-config>
