<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- IPTV portals frequently redirect to HTTP subdomains, CDN hosts or raw IP
         addresses. Permit those user-supplied playback/login endpoints so Media3
         and libVLC follow the same network policy. App-owned URLs are HTTPS. -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

</network-security-config>
