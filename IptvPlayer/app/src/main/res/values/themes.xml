<?xml version="1.0" encoding="utf-8"?>
<!-- Dark, TV-first theme. No action bar (custom 10-foot UI). -->
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.IptvPlayer" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/bg_root</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg_root</item>
        <item name="android:statusBarColor" tools:targetApi="lollipop">@color/bg_root</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>

    <!-- Reusable button look (focusable, accent on focus). -->
    <style name="Widget.Iptv.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:padding">@dimen/space_m</item>
        <item name="android:focusable">true</item>
    </style>

    <style name="Widget.Iptv.Input" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_muted</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:padding">@dimen/space_m</item>
    </style>

    <!-- Login hero feature row: magenta bullet + label. -->
    <style name="Widget.Iptv.Feature" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:drawableStart">@drawable/ic_dot</item>
        <item name="android:drawablePadding">@dimen/space_m</item>
    </style>

    <!-- Modern player dialogs: transparent window so our rounded surface shows,
         with a strong scrim behind for cinematic focus. -->
    <style name="ThemeOverlay.Iptv.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Circular top-bar action button for the dashboard. -->
    <style name="Widget.Iptv.IconButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:scaleType">centerInside</item>
        <item name="android:padding">@dimen/space_s</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Modern standard dialogs (Settings option lists + confirmations): a dark
         rounded glass surface, readable list items, bold accent buttons and a
         cinematic scrim — so the default white system dialog never shows. -->
    <style name="ThemeOverlay.Iptv.AlertDialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:backgroundDimAmount">0.72</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:textColorAlertDialogListItem">@color/text_primary</item>
        <item name="textColorAlertDialogListItem">@color/text_primary</item>
        <item name="colorControlHighlight">#33FF5FB0</item>
        <item name="buttonBarButtonStyle">@style/Widget.Iptv.Dialog.Button</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.Iptv.Dialog.Button.Primary</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.Iptv.Dialog.Button</item>
    </style>

    <style name="Widget.Iptv.Dialog.Button" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <style name="Widget.Iptv.Dialog.Button.Primary" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:textColor">@color/brand_pink</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/text_caption</item>
    </style>

    <!-- Single-select request-type chip (Home İstek & Şikayet dialog): even-width,
         D-pad focusable, fills brand-pink when selected (see bg_chip). -->
    <style name="Widget.Iptv.RequestChip" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">@dimen/space_s</item>
        <item name="android:paddingEnd">@dimen/space_s</item>
        <item name="android:paddingTop">@dimen/space_m</item>
        <item name="android:paddingBottom">@dimen/space_m</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>
</resources>
