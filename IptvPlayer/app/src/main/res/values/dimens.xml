<?xml version="1.0" encoding="utf-8"?>
<!-- 8dp spacing scale + TV-readable font sizes. Safe-area margin for overscan. -->
<resources>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">14dp</dimen>
    <dimen name="space_l">20dp</dimen>
    <dimen name="space_xl">28dp</dimen>

    <!-- ~5% safe area so content isn't cropped on old TVs. -->
    <dimen name="safe_area_h">36dp</dimen>
    <dimen name="safe_area_v">20dp</dimen>
    <dimen name="similar_poster_width">108dp</dimen>
    <dimen name="tile_radius">16dp</dimen>
    <dimen name="badge_radius">14dp</dimen>
    <dimen name="badge_hero">76dp</dimen>
    <dimen name="badge_medium">52dp</dimen>
    <dimen name="badge_small">42dp</dimen>

    <!-- Balanced 10-foot typography: readable without the previous zoomed feel. -->
    <dimen name="text_body">18sp</dimen>
    <dimen name="text_title">24sp</dimen>
    <dimen name="text_big_title">28sp</dimen>
    <dimen name="text_caption">15sp</dimen>
    <dimen name="text_small">12sp</dimen>
    <!-- Dashboard hero clock (reference-style oversized time read-out). -->
    <dimen name="text_clock">62sp</dimen>

    <!-- Detail (hero) screens: tighter than the global 10-foot sizes so the
         backdrop info block and season/episode rails do not feel zoomed-in. -->
    <dimen name="detail_title_text">24sp</dimen>
    <dimen name="detail_section_text">18sp</dimen>
    <dimen name="detail_meta_text">14sp</dimen>
    <dimen name="detail_action_text">15sp</dimen>

    <dimen name="category_width">220dp</dimen>
    <!-- Wider category rail for Movies/Series so long category names stay readable. -->
    <dimen name="category_width_wide">292dp</dimen>
    <!-- Compact catalog geometry targets five posters at the 960x540dp TV reference. -->
    <dimen name="catalog_category_width">236dp</dimen>
    <dimen name="info_width">268dp</dimen>
    <dimen name="channel_logo">48dp</dimen>
    <dimen name="card_radius">9dp</dimen>
    <dimen name="focus_stroke">2dp</dimen>

    <!-- First-run wizard. -->
    <dimen name="wizard_chip_min_height">56dp</dimen>
    <dimen name="wizard_dot_active">28dp</dimen>
    <dimen name="wizard_dot_inactive">10dp</dimen>

    <!-- Player option-sheet row height (audio/subtitle/sleep/delay dialogs). -->
    <dimen name="dialog_option_height">56dp</dimen>

    <!-- Posters (VOD / series grid). -->
    <dimen name="poster_width">128dp</dimen>
    <dimen name="poster_height">192dp</dimen>

    <!-- Left navigation rail (home dashboard). -->
    <dimen name="nav_rail_width">220dp</dimen>
    <dimen name="nav_item_height">52dp</dimen>

    <!-- Settings (master-detail layout). -->
    <dimen name="settings_row_min_h">52dp</dimen>
    <dimen name="settings_flag_w">36dp</dimen>
    <dimen name="settings_flag_h">24dp</dimen>
    <dimen name="settings_pin_box">48dp</dimen>
    <dimen name="settings_pin_key">48dp</dimen>
    <dimen name="settings_rail_padding">10dp</dimen>
    <dimen name="settings_panel_padding">12dp</dimen>
    <dimen name="settings_header_icon">38dp</dimen>
    <dimen name="settings_value_max_w">190dp</dimen>
    <dimen name="settings_info_value_max_w">260dp</dimen>
    <dimen name="settings_progress_height">6dp</dimen>
    <dimen name="settings_speed_result">48sp</dimen>

    <!-- EPG guide timeline. -->
    <dimen name="epg_row_height">54dp</dimen>
    <dimen name="epg_channel_col">190dp</dimen>
    <dimen name="epg_minute_width">6dp</dimen>

    <!-- Channel info / zap banner (bottom overlay shown on channel change).
         Reference 1920x1080 = 960x540dp; all values dp/sp. Side safe margin uses
         safe_area_h (48dp), bottom uses safe_area_v (27dp). -->
    <dimen name="zap_banner_height">96dp</dimen>
    <dimen name="zap_banner_logo">52dp</dimen>
    <dimen name="zap_number_min_width">34dp</dimen>
    <dimen name="zap_progress_height">3dp</dimen>
    <dimen name="zap_text_title">20sp</dimen>
    <dimen name="zap_text_number">17sp</dimen>
    <dimen name="zap_text_secondary">14sp</dimen>

    <!-- Inline fullscreen channel guide. Leaves enough width for the EPG card
         beside it at the 960x540dp TV reference size. -->
    <dimen name="fullscreen_guide_width">304dp</dimen>
    <dimen name="fullscreen_guide_epg_gap">12dp</dimen>
</resources>
