<?xml version="1.0" encoding="utf-8"?>
<!-- 8dp spacing scale + TV-readable font sizes. Safe-area margin for overscan. -->
<resources>
    <dimen name="space_xs">4dp</dimen>
    <dimen name="space_s">8dp</dimen>
    <dimen name="space_m">16dp</dimen>
    <dimen name="space_l">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>

    <!-- ~5% safe area so content isn't cropped on old TVs. -->
    <dimen name="safe_area_h">48dp</dimen>
    <dimen name="safe_area_v">27dp</dimen>
    <dimen name="tile_radius">20dp</dimen>
    <dimen name="badge_radius">16dp</dimen>
    <dimen name="badge_hero">88dp</dimen>
    <dimen name="badge_medium">60dp</dimen>
    <dimen name="badge_small">48dp</dimen>

    <!-- Font sizes (large, for 10-foot UI). -->
    <dimen name="text_body">20sp</dimen>
    <dimen name="text_title">28sp</dimen>
    <dimen name="text_big_title">32sp</dimen>
    <dimen name="text_caption">16sp</dimen>

    <!-- Detail (hero) screens: tighter than the global 10-foot sizes so the
         backdrop info block and season/episode rails do not feel zoomed-in. -->
    <dimen name="detail_title_text">26sp</dimen>
    <dimen name="detail_section_text">20sp</dimen>
    <dimen name="detail_meta_text">15sp</dimen>
    <dimen name="detail_action_text">16sp</dimen>

    <dimen name="category_width">248dp</dimen>
    <!-- Wider category rail for Movies/Series so long category names stay readable. -->
    <dimen name="category_width_wide">340dp</dimen>
    <dimen name="info_width">300dp</dimen>
    <dimen name="channel_logo">56dp</dimen>
    <dimen name="card_radius">10dp</dimen>
    <dimen name="focus_stroke">2dp</dimen>

    <!-- Player option-sheet row height (audio/subtitle/sleep/delay dialogs). -->
    <dimen name="dialog_option_height">56dp</dimen>

    <!-- Posters (VOD / series grid). -->
    <dimen name="poster_width">150dp</dimen>
    <dimen name="poster_height">225dp</dimen>

    <!-- Left navigation rail (home dashboard). -->
    <dimen name="nav_rail_width">220dp</dimen>
    <dimen name="nav_item_height">52dp</dimen>

    <!-- Settings (master-detail layout). -->
    <dimen name="settings_row_min_h">56dp</dimen>
    <dimen name="settings_flag_w">40dp</dimen>
    <dimen name="settings_flag_h">28dp</dimen>
    <dimen name="settings_pin_box">68dp</dimen>
    <dimen name="settings_pin_key">52dp</dimen>

    <!-- EPG guide timeline. -->
    <dimen name="epg_row_height">64dp</dimen>
    <dimen name="epg_channel_col">220dp</dimen>
    <dimen name="epg_minute_width">6dp</dimen>
</resources>
