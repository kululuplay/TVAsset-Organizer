<?xml version="1.0" encoding="utf-8"?>
<!-- Primary text on a Live TV list row: dark when the row is focused (white
     card), light otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#0E1216" />
    <item android:color="@color/text_primary" />
</selector>
