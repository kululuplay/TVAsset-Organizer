<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary text (count / number) on a Live TV list row: darker when focused,
     muted otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#3A434E" />
    <item android:color="@color/text_secondary" />
</selector>
