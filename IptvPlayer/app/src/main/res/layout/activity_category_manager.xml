<?xml version="1.0" encoding="utf-8"?>
<!-- Category editor: header (title + summary + reset) above a scrolling list of
     categories. OK shows/hides a row; hold to enter move mode; Live rows drill
     into the channel editor with ▶. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login_aurora"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_xs">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/cmTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cmSummary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/cmReset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/settings_row_min_h"
            android:gravity="center"
            android:text="@string/manager_reset"
            android:duplicateParentState="true"
            android:textColor="@color/settings_row_text"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:background="@drawable/bg_settings_row"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:paddingHorizontal="@dimen/space_m" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/cmHint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:layout_marginBottom="@dimen/space_m" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/categoryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />

    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/category_manager_empty"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:gravity="center"
        android:padding="@dimen/space_l"
        android:visibility="gone" />
</LinearLayout>
