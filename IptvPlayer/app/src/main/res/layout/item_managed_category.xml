<?xml version="1.0" encoding="utf-8"?>
<!-- Category editor row: name + count, a "hidden" badge, a "moving" badge and
     a trailing chevron (Live only, to drill into channels). Focusable for D-pad;
     children duplicateParentState so they recolor with the focused row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/settings_row_min_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_settings_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_s">

    <TextView
        android:id="@+id/mcName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@color/settings_row_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/mcCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:duplicateParentState="true"
        android:textColor="@color/settings_row_text"
        android:alpha="0.7"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/mcMoving"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/manager_moving"
        android:textColor="@color/accent"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/space_s"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mcHidden"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/channel_manager_hidden"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_caption"
        android:layout_marginStart="@dimen/space_s"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/mcArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:duplicateParentState="true"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right"
        app:tint="@color/settings_row_text"
        android:visibility="gone"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
