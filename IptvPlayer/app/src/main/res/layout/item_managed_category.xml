<?xml version="1.0" encoding="utf-8"?>
<!-- One category is one remote target. Child semantics are merged into the row,
     while selected state is used exclusively to communicate move mode. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_content_manager_row"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:importantForAccessibility="yes"
    android:longClickable="true"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_s">

    <View
        android:layout_width="4dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_content_manager_row_accent"
        android:duplicateParentState="true"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/mcName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/settings_row_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mcCount"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_content_manager_count"
        android:duplicateParentState="true"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:minWidth="48dp"
        android:paddingHorizontal="@dimen/space_s"
        android:textColor="@color/settings_row_text"
        android:textSize="@dimen/text_caption" />

    <TextView
        android:id="@+id/mcMoving"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_content_manager_moving"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/space_s"
        android:text="@string/manager_moving"
        android:textColor="@color/brand_pink"
        android:textSize="@dimen/text_small"
        android:textStyle="bold"
        android:visibility="gone" />

    <TextView
        android:id="@+id/mcHidden"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginStart="@dimen/space_s"
        android:background="@drawable/bg_content_manager_hidden"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:paddingHorizontal="@dimen/space_s"
        android:text="@string/channel_manager_hidden"
        android:textColor="@color/warning"
        android:textSize="@dimen/text_small"
        android:textStyle="bold"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/mcArrow"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_m"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_arrow_right"
        android:visibility="gone"
        app:tint="@color/settings_row_text" />
</LinearLayout>
