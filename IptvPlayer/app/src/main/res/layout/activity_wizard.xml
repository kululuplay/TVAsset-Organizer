<?xml version="1.0" encoding="utf-8"?>
<!-- Premium first-run experience built from lightweight XML surfaces so it stays
     smooth on low-power Android TV sticks. Every action is D-pad reachable. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/safe_area_h"
        android:paddingTop="@dimen/safe_area_v"
        android:paddingEnd="@dimen/safe_area_h"
        android:paddingBottom="@dimen/safe_area_v">

        <LinearLayout
            android:id="@+id/wizardHero"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginEnd="@dimen/space_l"
            android:layout_weight="0.86"
            android:background="@drawable/bg_onboarding_hero_panel"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:background="@drawable/bg_logo_badge"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_kululu_logo" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/app_name"
                        android:textColor="@color/text_primary"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:background="@drawable/bg_onboarding_chip"
                        android:drawableStart="@drawable/ic_lock"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:paddingStart="@dimen/space_s"
                        android:paddingTop="@dimen/space_xs"
                        android:paddingEnd="@dimen/space_s"
                        android:paddingBottom="@dimen/space_xs"
                        android:text="@string/onboarding_tv_ready"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_small" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xl"
                android:letterSpacing="0.12"
                android:text="@string/wizard_intro_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/brand_pink"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:maxLines="2"
                android:text="@string/wizard_intro_title"
                android:textColor="@color/text_primary"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:maxLines="3"
                android:text="@string/wizard_intro_body"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/railStep0"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_wizard_rail_step"
                    android:drawableStart="@drawable/ic_tv"
                    android:drawablePadding="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:text="@string/wizard_step_welcome_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/railStep1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_wizard_rail_step"
                    android:drawableStart="@drawable/ic_globe"
                    android:drawablePadding="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:text="@string/wizard_step_language_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/railStep2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_s"
                    android:background="@drawable/bg_wizard_rail_step"
                    android:drawableStart="@drawable/ic_lock"
                    android:drawablePadding="@dimen/space_m"
                    android:gravity="center_vertical"
                    android:minHeight="50dp"
                    android:paddingStart="@dimen/space_m"
                    android:paddingEnd="@dimen/space_m"
                    android:text="@string/wizard_step_connect_label"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.14"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="never">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:minHeight="560dp"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/wizardCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_onboarding_card"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:orientation="vertical"
                    android:padding="@dimen/space_l">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/dot0"
                            android:layout_width="@dimen/wizard_dot_inactive"
                            android:layout_height="6dp"
                            android:layout_marginEnd="@dimen/space_xs"
                            android:background="@drawable/bg_step_dot" />

                        <View
                            android:id="@+id/dot1"
                            android:layout_width="@dimen/wizard_dot_inactive"
                            android:layout_height="6dp"
                            android:layout_marginEnd="@dimen/space_xs"
                            android:background="@drawable/bg_step_dot" />

                        <View
                            android:id="@+id/dot2"
                            android:layout_width="@dimen/wizard_dot_inactive"
                            android:layout_height="6dp"
                            android:background="@drawable/bg_step_dot" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/stepCounter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/stepContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/stepIcon"
                                android:layout_width="56dp"
                                android:layout_height="56dp"
                                android:background="@drawable/bg_onboarding_step_icon"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="14dp"
                                android:src="@drawable/ic_tv" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_m"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/stepEyebrow"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:letterSpacing="0.1"
                                    android:textAllCaps="true"
                                    android:textColor="@color/brand_pink"
                                    android:textSize="@dimen/text_small"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/stepTitle"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/text_title"
                                    android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/stepSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/welcomeHighlights"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_l"
                            android:background="@drawable/bg_onboarding_helper"
                            android:drawableStart="@drawable/ic_check"
                            android:drawablePadding="@dimen/space_m"
                            android:gravity="center_vertical"
                            android:minHeight="70dp"
                            android:padding="@dimen/space_m"
                            android:text="@string/wizard_welcome_helper"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_caption" />

                        <FrameLayout
                            android:id="@+id/languageScroll"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:visibility="gone">

                            <GridLayout
                                android:id="@+id/languageGroup"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:columnCount="2" />
                        </FrameLayout>

                        <LinearLayout
                            android:id="@+id/connectSummary"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_onboarding_feature"
                                android:drawableStart="@drawable/ic_lock"
                                android:drawablePadding="@dimen/space_m"
                                android:gravity="center_vertical"
                                android:minHeight="58dp"
                                android:padding="@dimen/space_m"
                                android:text="@string/wizard_connect_secure_body"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:background="@drawable/bg_onboarding_feature"
                                android:drawableStart="@drawable/ic_check"
                                android:drawablePadding="@dimen/space_m"
                                android:gravity="center_vertical"
                                android:minHeight="58dp"
                                android:padding="@dimen/space_m"
                                android:text="@string/wizard_connect_private_body"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/wizardInlineError"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:accessibilityLiveRegion="polite"
                        android:background="@drawable/bg_wizard_inline_error"
                        android:drawableStart="@drawable/ic_feedback"
                        android:drawablePadding="@dimen/space_s"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:padding="@dimen/space_m"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/wizardStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_m"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <ProgressBar
                            android:layout_width="24dp"
                            android:layout_height="24dp" />

                        <TextView
                            android:id="@+id/wizardStatusText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_s"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/wizardNavigation"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_l"
                        android:clipChildren="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnBack"
                            style="@style/Widget.Iptv.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/space_s"
                            android:layout_weight="1"
                            android:text="@string/action_back"
                            android:visibility="gone" />

                        <Button
                            android:id="@+id/btnNext"
                            style="@style/Widget.Iptv.Button"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_button_primary"
                            android:text="@string/wizard_cta_start"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
