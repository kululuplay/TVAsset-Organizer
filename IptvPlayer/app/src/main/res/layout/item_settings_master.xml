<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable TV settings row: a strong transient focus state, a quieter persistent
     selection state, and bounded trailing content for compact screens/font scaling. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    android:background="@drawable/bg_settings_row"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:minHeight="@dimen/settings_row_min_h"
    android:orientation="horizontal"
    android:paddingStart="@dimen/space_m"
    android:paddingTop="@dimen/space_s"
    android:paddingEnd="@dimen/space_m"
    android:paddingBottom="@dimen/space_s"
    android:stateListAnimator="@animator/control_focus">

    <TextView
        android:id="@+id/mTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/settings_row_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/mValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="end|center_vertical"
        android:maxLines="2"
        android:maxWidth="@dimen/settings_value_max_w"
        android:textColor="@color/settings_row_text_secondary"
        android:textSize="@dimen/text_caption"
        android:visibility="gone" />

    <androidx.appcompat.widget.SwitchCompat
        android:id="@+id/mSwitch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:clickable="false"
        android:focusable="false"
        app:thumbTint="@color/settings_switch_thumb"
        app:trackTint="@color/settings_switch_track"
        android:visibility="gone" />
</LinearLayout>
