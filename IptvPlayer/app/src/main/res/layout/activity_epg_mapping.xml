<?xml version="1.0" encoding="utf-8"?>
<!-- EPG matching: enter/confirm the guide channel id (tvg-id / epg_channel_id)
     for a given live channel. Centered card, D-pad friendly, safe-area padding. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/safe_area_h"
        android:paddingVertical="@dimen/safe_area_v">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/epg_mapping_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_big_title"
            android:textStyle="bold"
            android:layout_marginBottom="@dimen/space_s" />

        <TextView
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:text="@string/epg_mapping_hint"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:gravity="center"
            android:layout_marginBottom="@dimen/space_m" />

        <TextView
            android:id="@+id/channelName"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:gravity="center"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="@dimen/space_m" />

        <EditText
            android:id="@+id/inputEpgId"
            style="@style/Widget.Iptv.Input"
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:hint="@string/epg_mapping_input_hint"
            android:inputType="text"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="560dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/space_l">

            <Button
                android:id="@+id/btnSave"
                style="@style/Widget.Iptv.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_save"
                android:layout_marginEnd="@dimen/space_s" />

            <Button
                android:id="@+id/btnCancel"
                style="@style/Widget.Iptv.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/action_cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
