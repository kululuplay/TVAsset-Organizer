<?xml version="1.0" encoding="utf-8"?>
<!-- Profiles: list of saved subscriptions with an "Add profile" action. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_m">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/settings_profiles"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_big_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnAddProfile"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/settings_add_profile" />
    </LinearLayout>

    <TextView
        android:id="@+id/profilesEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/profiles_empty"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/space_l"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/profileList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false" />
</LinearLayout>
