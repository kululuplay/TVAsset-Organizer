<?xml version="1.0" encoding="utf-8"?>
<!-- Crash recovery screen: shows the captured crash trace plus a Share/Retry
     action. Kept intentionally simple and dependency-light so it opens even when
     the rest of the app's startup path is failing. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/recovery_title"
        android:textColor="@color/text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/recovery_message"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/recoveryDevice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <!-- Safe-mode notice; shown only when repeated launch crashes triggered the
         automatic reset of the playback settings (see CrashRecoveryActivity). -->
    <TextView
        android:id="@+id/recoverySafeMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/recovery_safe_mode"
        android:textColor="@color/warning"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="16dp"
        android:background="@color/bg_panel"
        android:padding="12dp"
        android:focusable="true">

        <TextView
            android:id="@+id/recoveryLog"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnRecoveryShare"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/recovery_share"
            android:focusable="true" />

        <Button
            android:id="@+id/btnRecoveryRetry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="@string/recovery_retry"
            android:focusable="true" />
    </LinearLayout>
</LinearLayout>
