<?xml version="1.0" encoding="utf-8"?>
<!-- Diagnostics: run connectivity tests, show device info and share a log summary. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login_aurora"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/diag_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_big_title"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/space_m" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="@dimen/space_m">

        <Button
            android:id="@+id/btnRunTests"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_run" />

        <Button
            android:id="@+id/btnSendLogs"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:text="@string/diag_send_logs" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/diagResults"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/diag_device"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:textAllCaps="true"
                android:layout_marginTop="@dimen/space_l"
                android:layout_marginBottom="@dimen/space_s" />

            <TextView
                android:id="@+id/deviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_glass_card"
                android:padding="@dimen/space_m"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:lineSpacingMultiplier="1.3" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
