<?xml version="1.0" encoding="utf-8"?>
<!-- Cinematic series detail screen designed for a 10-foot TV interface. Every
     focusable rail lives in one vertical scroll path, with stable fixed-height
     season/episode targets and explicit loading/error/empty surfaces. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_series_catalog">

    <ImageView
        android:id="@+id/detailBackdrop"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.30"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_scrim_left"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_scrim_bottom"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scrollBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:descendantFocusability="afterDescendants"
        android:fillViewport="true"
        android:focusable="false"
        android:overScrollMode="never"
        android:paddingStart="@dimen/safe_area_h"
        android:paddingTop="@dimen/safe_area_v"
        android:paddingEnd="@dimen/safe_area_h"
        android:paddingBottom="@dimen/safe_area_v"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="326dp"
                android:background="@drawable/bg_series_detail_panel">

                <LinearLayout
                    android:id="@+id/heroContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:padding="22dp"
                    android:visibility="invisible">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="26dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_series_meta_chip"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="10dp"
                            android:paddingTop="5dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="5dp">

                            <ImageView
                                android:layout_width="15dp"
                                android:layout_height="15dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_series"
                                app:tint="@color/brand_pink" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:text="@string/nav_series"
                                android:textAllCaps="true"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_small"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/detailTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:ellipsize="end"
                            android:maxLines="2"
                            android:text="@string/nav_series"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_big_title"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/ratingContainer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:importantForAccessibility="yes"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/ratingStars"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:gravity="center_vertical"
                                    android:importantForAccessibility="no"
                                    android:orientation="horizontal">

                                    <ImageView android:id="@+id/star1" android:layout_width="17dp" android:layout_height="17dp" android:contentDescription="@null" android:src="@drawable/ic_star_outline" />
                                    <ImageView android:id="@+id/star2" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="2dp" android:contentDescription="@null" android:src="@drawable/ic_star_outline" />
                                    <ImageView android:id="@+id/star3" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="2dp" android:contentDescription="@null" android:src="@drawable/ic_star_outline" />
                                    <ImageView android:id="@+id/star4" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="2dp" android:contentDescription="@null" android:src="@drawable/ic_star_outline" />
                                    <ImageView android:id="@+id/star5" android:layout_width="17dp" android:layout_height="17dp" android:layout_marginStart="2dp" android:contentDescription="@null" android:src="@drawable/ic_star_outline" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:id="@+id/detailYear"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:background="@drawable/bg_series_meta_chip"
                                android:paddingStart="9dp"
                                android:paddingTop="3dp"
                                android:paddingEnd="9dp"
                                android:paddingBottom="3dp"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/detail_meta_text"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/detailDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:drawableStart="@drawable/ic_clock"
                                android:drawablePadding="5dp"
                                android:gravity="center_vertical"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/detail_meta_text"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/detailGenre"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:layout_weight="1"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/detail_meta_text"
                                android:visibility="gone" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/detailPlot"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:ellipsize="end"
                            android:lineSpacingExtra="2dp"
                            android:maxLines="3"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/detail_meta_text"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/detailMore"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginTop="7dp"
                            android:background="@drawable/bg_pill_dark"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:gravity="center"
                            android:paddingStart="14dp"
                            android:paddingEnd="14dp"
                            android:stateListAnimator="@animator/control_focus"
                            android:text="@string/detail_more"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/actionRow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="18dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/playButton"
                                android:layout_width="wrap_content"
                                android:layout_height="52dp"
                                android:background="@drawable/bg_pill_light"
                                android:enabled="false"
                                android:focusable="false"
                                android:focusableInTouchMode="false"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="22dp"
                                android:paddingEnd="22dp"
                                android:stateListAnimator="@animator/control_focus">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_marginEnd="8dp"
                                    android:contentDescription="@null"
                                    android:src="@drawable/ic_play"
                                    app:tint="#101820" />

                                <TextView
                                    android:id="@+id/playLabel"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/loading"
                                    android:textColor="#101820"
                                    android:textSize="@dimen/detail_action_text"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <TextView
                                android:id="@+id/trailerButton"
                                android:layout_width="wrap_content"
                                android:layout_height="52dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_pill_dark"
                                android:focusable="true"
                                android:focusableInTouchMode="false"
                                android:gravity="center"
                                android:paddingStart="20dp"
                                android:paddingEnd="20dp"
                                android:stateListAnimator="@animator/control_focus"
                                android:text="@string/detail_trailer"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/detail_action_text"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/favoriteButton"
                                android:layout_width="52dp"
                                android:layout_height="52dp"
                                android:layout_marginStart="10dp"
                                android:background="@drawable/bg_pill_dark"
                                android:contentDescription="@string/section_favorites"
                                android:focusable="true"
                                android:focusableInTouchMode="false"
                                android:padding="15dp"
                                android:src="@drawable/ic_heart"
                                android:stateListAnimator="@animator/control_focus" />
                        </LinearLayout>
                    </LinearLayout>

                    <FrameLayout
                        android:layout_width="190dp"
                        android:layout_height="285dp"
                        android:background="@drawable/bg_series_detail_poster"
                        android:padding="3dp">

                        <ImageView
                            android:id="@+id/detailPoster"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_series_art_frame"
                            android:clipToOutline="true"
                            android:contentDescription="@null"
                            android:scaleType="centerCrop" />
                    </FrameLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/headerLoadingContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_series_state_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="22dp"
                    android:visibility="visible">

                    <ProgressBar
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:indeterminateTint="@color/brand_pink" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:text="@string/loading"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/headerErrorContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityLiveRegion="assertive"
                    android:background="@drawable/bg_series_state_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxWidth="420dp"
                        android:text="@string/error_unknown"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_body" />

                    <Button
                        android:id="@+id/headerRetryButton"
                        style="@style/Widget.Iptv.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="@string/action_retry" />
                </LinearLayout>
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/brand_pink"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/seasonsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/detail_seasons"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/detail_section_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/seasonList"
                android:layout_width="match_parent"
                android:layout_height="66dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingStart="3dp"
                android:paddingTop="7dp"
                android:paddingEnd="3dp"
                android:paddingBottom="7dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="4dp"
                    android:layout_height="24dp"
                    android:background="@color/brand_purple"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/episodesLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/detail_episodes"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/detail_section_text"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="226dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/episodeList"
                    android:layout_width="match_parent"
                    android:layout_height="222dp"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="3dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="3dp"
                    android:paddingBottom="6dp"
                    android:visibility="invisible" />

                <ProgressBar
                    android:id="@+id/loading"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:contentDescription="@string/loading"
                    android:indeterminateTint="@color/brand_pink"
                    android:visibility="visible" />

                <LinearLayout
                    android:id="@+id/episodeEmptyContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:accessibilityLiveRegion="polite"
                    android:background="@drawable/bg_series_state_card"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingStart="30dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="30dp"
                    android:paddingBottom="20dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/emptyState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:maxWidth="440dp"
                        android:text="@string/empty_episodes"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/detail_meta_text" />

                    <Button
                        android:id="@+id/episodeRetryButton"
                        style="@style/Widget.Iptv.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/action_retry" />
                </LinearLayout>
            </FrameLayout>

            <TextView
                android:id="@+id/castLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/detail_cast"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/detail_section_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/castList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:clipToPadding="false"
                android:descendantFocusability="blocksDescendants"
                android:focusable="false"
                android:overScrollMode="never"
                android:visibility="gone" />

            <TextView
                android:id="@+id/similarLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/detail_similar"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/detail_section_text"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/similarList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="12dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:importantForAccessibility="no" />
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
