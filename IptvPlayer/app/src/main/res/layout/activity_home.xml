<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Android TV live browser. The left rail drills categories into channels;
     the right side keeps the playing preview distinct from the focused EPG channel. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_live_modern"
    android:clipChildren="false"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/splitGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.33" />

    <!-- Categories / channels rail. -->
    <LinearLayout
        android:id="@+id/leftPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_live_panel"
        android:clipChildren="false"
        android:orientation="vertical"
        android:padding="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/splitGuide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/browserIcon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/bg_live_section_chip"
                android:contentDescription="@null"
                android:padding="8dp"
                android:src="@drawable/ic_tv"
                app:tint="@color/live_cyan" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/browserTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/nav_live"
                    android:textColor="@color/text_primary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/browseModeLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/categories_title"
                    android:textAllCaps="true"
                    android:textColor="@color/live_cyan"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/browseCount"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/bg_live_count_chip"
                android:gravity="center"
                android:minWidth="38dp"
                android:paddingHorizontal="8dp"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/bg_icon_button"
                android:contentDescription="@string/action_refresh"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@id/searchInput"
                android:nextFocusLeft="@id/refreshButton"
                android:nextFocusRight="@id/previewCard"
                android:nextFocusUp="@id/refreshButton"
                android:padding="10dp"
                android:src="@drawable/ic_refresh"
                android:stateListAnimator="@animator/control_focus"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <EditText
            android:id="@+id/searchInput"
            style="@style/Widget.Iptv.Input"
            android:layout_width="match_parent"
            android:layout_height="42dp"
            android:layout_marginBottom="8dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/bg_input_modern"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="9dp"
            android:hint="@string/search_channels_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:nextFocusDown="@id/categoryList"
            android:nextFocusRight="@id/previewCard"
            android:nextFocusUp="@id/refreshButton"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textSize="15sp" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusRight="@id/previewCard"
                android:paddingBottom="8dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:nextFocusLeft="@id/categoryList"
                android:nextFocusRight="@id/previewCard"
                android:paddingBottom="8dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="18dp"
                android:text="@string/empty_channels"
                android:textColor="@color/text_secondary"
                android:textSize="16sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/live_cyan"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/loadErrorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_live_panel"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/loadErrorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp" />

                <Button
                    android:id="@+id/retryButton"
                    style="@style/Widget.Iptv.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/action_retry" />
            </LinearLayout>

            <TextView
                android:id="@+id/zapOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_zap_banner"
                android:paddingHorizontal="18dp"
                android:paddingVertical="7dp"
                android:textColor="@color/text_primary"
                android:textSize="28sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Playing preview and guide for the channel currently under focus. -->
    <LinearLayout
        android:id="@+id/rightPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipChildren="false"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@id/splitGuide"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:id="@+id/previewHeader"
            android:layout_width="match_parent"
            android:layout_height="34dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/previewHeaderTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:drawablePadding="8dp"
                android:text="@string/live_preview_title"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_signal"
                app:drawableTint="@color/live_cyan" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="26dp"
                android:background="@drawable/bg_preview_hint"
                android:gravity="center"
                android:paddingHorizontal="10dp"
                android:text="@string/live_preview_hint"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:layout_weight="58"
            android:background="@drawable/bg_preview"
            android:clickable="true"
            android:clipToOutline="true"
            android:contentDescription="@string/live_preview_title"
            android:focusable="true"
            android:focusableInTouchMode="false"
            android:foreground="@drawable/bg_tile_focus"
            android:nextFocusDown="@id/previewCard"
            android:nextFocusLeft="@id/channelList"
            android:nextFocusRight="@id/previewCard"
            android:nextFocusUp="@id/refreshButton"
            android:stateListAnimator="@animator/control_focus">

            <FrameLayout
                android:id="@+id/previewVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Opaque until the active engine confirms a non-green frame. -->
            <View
                android:id="@+id/previewPlaybackCover"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/black"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/infoLogo"
                android:layout_width="104dp"
                android:layout_height="88dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_channel_logo_plate"
                android:contentDescription="@string/now_playing"
                android:padding="14dp"
                android:scaleType="fitCenter"
                android:translationY="-14dp"
                android:visibility="invisible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical">

                <ProgressBar
                    android:id="@+id/previewLoading"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:indeterminateTint="@color/live_cyan"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:background="@drawable/bg_overlay"
                    android:gravity="center"
                    android:maxWidth="420dp"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="7dp"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/debugOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="12dp"
                android:background="@drawable/bg_zap_banner"
                android:fontFamily="monospace"
                android:lineSpacingExtra="1dp"
                android:padding="8dp"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/catchupHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="12dp"
                android:background="@drawable/bg_badge_catchup"
                android:drawablePadding="7dp"
                android:gravity="center_vertical"
                android:paddingHorizontal="11dp"
                android:paddingVertical="7dp"
                android:text="@string/catchup_title"
                android:textColor="@color/text_primary"
                android:textSize="12sp"
                android:textStyle="bold"
                android:visibility="gone"
                app:drawableStartCompat="@drawable/ic_catchup" />

            <LinearLayout
                android:id="@+id/previewCaption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_preview_caption"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="13dp"
                android:paddingBottom="10dp"
                android:paddingTop="18dp">

                <TextView
                    android:id="@+id/previewLiveBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_epg_live_badge"
                    android:gravity="center"
                    android:paddingHorizontal="9dp"
                    android:text="@string/live_label"
                    android:textColor="@android:color/white"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/previewNumber"
                    android:layout_width="36dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="9dp"
                    android:background="@drawable/bg_channel_number_chip"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <FrameLayout
                    android:id="@+id/previewCaptionLogoPlate"
                    android:layout_width="50dp"
                    android:layout_height="36dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@drawable/bg_channel_logo_plate"
                    android:padding="5dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/previewCaptionLogo"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/now_playing"
                        android:scaleType="fitCenter" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/previewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/previewProgram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                    android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Fullscreen-only channel + now/next EPG card. It lives inside the
                 existing preview surface, so expanding the card never moves or
                 recreates the player view underneath it. -->
            <LinearLayout
                android:id="@+id/fullscreenEpgOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginStart="@dimen/safe_area_h"
                android:layout_marginEnd="@dimen/safe_area_h"
                android:layout_marginBottom="@dimen/safe_area_v"
                android:background="@drawable/bg_fullscreen_epg_card"
                android:elevation="18dp"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="10dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:visibility="gone">

                <!-- Channel identity row. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:minHeight="44dp"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:layout_width="56dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_channel_logo_plate"
                        android:padding="6dp">

                        <ImageView
                            android:id="@+id/fullscreenEpgLogo"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/now_playing"
                            android:scaleType="fitCenter" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/fullscreenEpgNumber"
                        android:layout_width="40dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="9dp"
                        android:background="@drawable/bg_channel_number_chip"
                        android:gravity="center"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/fullscreenEpgChannelName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/fullscreenEpgCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@color/live_text_dim"
                            android:textSize="14sp"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_epg_live_badge"
                        android:gravity="center"
                        android:minHeight="26dp"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/live_label"
                        android:textColor="@android:color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Current programme + remaining time. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="7dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/now_playing"
                        android:textAllCaps="true"
                        android:textColor="@color/live_cyan"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fullscreenEpgNowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fullscreenEpgRemaining"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_time_chip"
                        android:gravity="center"
                        android:minHeight="28dp"
                        android:minWidth="76dp"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:textColor="@color/live_cyan"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/fullscreenEpgProgress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="6dp"
                    android:max="100"
                    android:progressDrawable="@drawable/progress_fullscreen_epg"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/fullscreenEpgTimingRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/fullscreenEpgStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/text_secondary"
                        android:textDirection="ltr"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/fullscreenEpgEnd"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textDirection="ltr"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Next programme row. -->
                <LinearLayout
                    android:id="@+id/fullscreenEpgNextRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center_vertical"
                    android:minHeight="34dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_next_pill"
                        android:gravity="center"
                        android:minHeight="26dp"
                        android:paddingStart="10dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="4dp"
                        android:text="@string/up_next"
                        android:textColor="@color/text_primary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/fullscreenEpgNextTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/text_secondary"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/fullscreenEpgNextStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="@color/live_cyan"
                        android:textDirection="ltr"
                        android:textSize="16sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- Remote-first fullscreen channel rail. The video SurfaceView stays
                 untouched underneath; the EPG card is shifted beside this panel
                 while the guide is open. -->
            <FrameLayout
                android:id="@+id/fullscreenGuideOverlay"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:elevation="20dp"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_fullscreen_guide_scrim"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:id="@+id/fullscreenGuidePanel"
                    android:layout_width="@dimen/fullscreen_guide_width"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_marginStart="@dimen/safe_area_h"
                    android:layout_marginTop="@dimen/safe_area_v"
                    android:layout_marginBottom="@dimen/safe_area_v"
                    android:background="@drawable/bg_fullscreen_guide_panel"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="14dp"
                    android:paddingBottom="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="48dp"
                        android:orientation="horizontal">

                        <FrameLayout
                            android:layout_width="42dp"
                            android:layout_height="42dp"
                            android:background="@drawable/bg_channel_number_chip"
                            android:padding="9dp">

                            <ImageView
                                android:id="@+id/fullscreenGuideIcon"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="@string/channels_title"
                                android:src="@drawable/ic_tv"
                                app:tint="@color/live_cyan" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/fullscreenGuideTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/channels_title"
                                android:textColor="@color/text_primary"
                                android:textSize="20sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/fullscreenGuideCategory"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="1dp"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textColor="@color/live_cyan"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/fullscreenGuideCount"
                            android:layout_width="wrap_content"
                            android:layout_height="30dp"
                            android:background="@drawable/bg_time_chip"
                            android:gravity="center"
                            android:minWidth="42dp"
                            android:paddingStart="9dp"
                            android:paddingEnd="9dp"
                            android:textColor="@color/text_primary"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="9dp"
                        android:background="@color/live_stroke" />

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/fullscreenGuideList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:clipToPadding="false"
                            android:descendantFocusability="afterDescendants"
                            android:focusable="true"
                            android:overScrollMode="never"
                            android:paddingTop="2dp"
                            android:paddingBottom="8dp" />

                        <TextView
                            android:id="@+id/fullscreenGuideEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="@string/empty_channels"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:visibility="gone" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_time_chip"
                        android:gravity="center"
                        android:minHeight="30dp"
                        android:paddingStart="8dp"
                        android:paddingTop="5dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="5dp"
                        android:text="@string/fullscreen_guide_hint"
                        android:textColor="@color/live_text_dim"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>
        </FrameLayout>

        <LinearLayout
            android:id="@+id/guidePanel"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="11dp"
            android:layout_weight="42"
            android:background="@drawable/bg_live_panel"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingBottom="10dp"
            android:paddingTop="9dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/program_guide_title"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="1dp"
                    android:layout_height="16dp"
                    android:layout_marginHorizontal="10dp"
                    android:background="@color/live_stroke" />

                <TextView
                    android:id="@+id/guideChannelTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/live_cyan"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/epgList"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:focusable="false"
                    android:paddingTop="2dp" />

                <ProgressBar
                    android:id="@+id/epgLoading"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/live_cyan"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/epgEmpty"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="@string/no_guide"
                    android:textColor="@color/text_muted"
                    android:textSize="13sp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Number-zap feedback must remain visible when the browser rail is GONE. -->
    <TextView
        android:id="@+id/fullscreenZapOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/safe_area_h"
        android:layout_marginTop="@dimen/safe_area_v"
        android:background="@drawable/bg_zap_banner"
        android:elevation="20dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="7dp"
        android:textColor="@color/text_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
