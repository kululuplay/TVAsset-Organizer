<?xml version="1.0" encoding="utf-8"?>
<!-- TV home: a top navigation bar (Live / Guide / Movies / Series / Settings)
     with a live clock, above the 3-pane Live browser (categories | channels |
     info). Safe-area padding keeps content inside the visible TV area. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_root"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <!-- Top navigation bar -->
    <LinearLayout
        android:id="@+id/navBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/accent"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginEnd="@dimen/space_l" />

        <TextView
            android:id="@+id/navLive"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_live"
            android:layout_marginEnd="@dimen/space_s" />

        <TextView
            android:id="@+id/navGuide"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_guide"
            android:layout_marginEnd="@dimen/space_s" />

        <TextView
            android:id="@+id/navMovies"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_movies"
            android:layout_marginEnd="@dimen/space_s" />

        <TextView
            android:id="@+id/navSeries"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_series"
            android:layout_marginEnd="@dimen/space_s" />

        <TextView
            android:id="@+id/navSettings"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_settings" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <com.iptv.player.ui.common.ClockView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Left: categories -->
    <LinearLayout
        android:id="@+id/categoryPanel"
        android:layout_width="@dimen/category_width"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/space_s"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_live"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:padding="@dimen/space_s"
            android:layout_marginBottom="@dimen/space_xs" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/categoryList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="false" />
    </LinearLayout>

    <!-- Center: channels -->
    <FrameLayout
        android:id="@+id/channelPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginHorizontal="@dimen/space_m"
        app:layout_constraintStart_toEndOf="@id/categoryPanel"
        app:layout_constraintEnd_toStartOf="@id/infoPanel"
        app:layout_constraintTop_toBottomOf="@id/navBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/channelList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/empty_channels"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:visibility="gone" />

        <!-- Number-key zap overlay (TV remote channel entry). -->
        <TextView
            android:id="@+id/zapOverlay"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:background="@drawable/bg_overlay"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_s"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_big_title"
            android:textStyle="bold"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Right: info panel -->
    <LinearLayout
        android:id="@+id/infoPanel"
        android:layout_width="@dimen/info_width"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:background="@drawable/bg_panel"
        android:padding="@dimen/space_m"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/navBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:id="@+id/infoLogo"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:scaleType="fitCenter"
            android:layout_marginTop="@dimen/space_l"
            android:layout_marginBottom="@dimen/space_m"
            android:contentDescription="@string/now_playing" />

        <TextView
            android:id="@+id/infoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/infoCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:layout_marginTop="@dimen/space_s" />

        <!-- Now / Next EPG for the focused channel. -->
        <TextView
            android:id="@+id/infoNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:layout_marginTop="@dimen/space_m"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/infoNext"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:layout_marginTop="@dimen/space_xs"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
