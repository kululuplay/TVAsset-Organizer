<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV browser, 2-pane design.
       LEFT  = a single list that shows categories, and drills into that
               category's channels on OK (Back returns to categories).
       RIGHT = a large channel preview (top) with a caption overlay
               (number + name + current program) and the EPG schedule list
               (bottom). Fully D-pad driven. View IDs are preserved where
               possible so HomeActivity binding stays compatible. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/splitGuide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintGuide_percent="0.4" />

    <!-- LEFT pane: categories OR channels (drill-down) -->
    <LinearLayout
        android:id="@+id/leftPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/space_l"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:padding="@dimen/space_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/splitGuide"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/browserTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/nav_live"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/refreshButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_poster"
                android:contentDescription="@string/action_refresh"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:nextFocusDown="@id/searchInput"
                android:padding="@dimen/space_s"
                android:stateListAnimator="@animator/control_focus"
                android:src="@drawable/ic_refresh"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <EditText
            android:id="@+id/searchInput"
            style="@style/Widget.Iptv.Input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_m"
            android:layout_marginTop="@dimen/space_s"
            android:background="@drawable/bg_input_modern"
            android:drawableStart="@drawable/ic_search"
            android:drawablePadding="@dimen/space_s"
            android:hint="@string/search_channels_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/categoryList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:preserveFocusAfterLayout="true"
                android:paddingBottom="@dimen/space_m" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/channelList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:preserveFocusAfterLayout="true"
                android:paddingBottom="@dimen/space_m"
                android:visibility="gone" />

            <TextView
                android:id="@+id/emptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="@string/empty_channels"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/loadingIndicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/loadErrorContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/bg_glass_card"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="@dimen/space_l"
                android:visibility="gone">

                <TextView
                    android:id="@+id/loadErrorText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <Button
                    android:id="@+id/retryButton"
                    style="@style/Widget.Iptv.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:text="@string/action_retry" />
            </LinearLayout>

            <!-- Number-key zap overlay (TV remote channel entry). -->
            <TextView
                android:id="@+id/zapOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:background="@drawable/bg_overlay"
                android:paddingHorizontal="@dimen/space_l"
                android:paddingVertical="@dimen/space_s"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_big_title"
                android:textStyle="bold"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- RIGHT pane: preview + EPG -->
    <LinearLayout
        android:id="@+id/rightPane"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintStart_toStartOf="@id/splitGuide"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Channel preview surface with caption overlay -->
        <FrameLayout
            android:id="@+id/previewCard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:background="@drawable/bg_preview"
            android:foreground="@drawable/bg_tile_focus"
            android:focusable="true"
            android:clickable="true">

            <!-- Live preview surface: the focused channel plays here while browsing.
                 Sits behind the poster logo + caption. -->
            <FrameLayout
                android:id="@+id/previewVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/infoLogo"
                android:layout_width="140dp"
                android:layout_height="140dp"
                android:layout_gravity="center"
                android:scaleType="fitCenter"
                android:contentDescription="@string/now_playing" />

            <TextView
                android:id="@+id/previewStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="104dp"
                android:background="@drawable/bg_overlay"
                android:gravity="center"
                android:maxWidth="420dp"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_s"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />

            <!-- Debug overlay: engine/stage/resolution + live PlaybackLog tail.
                 Gated by the Debug setting (hidden by default). -->
            <TextView
                android:id="@+id/debugOverlay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="@dimen/space_m"
                android:padding="@dimen/space_s"
                android:background="@drawable/bg_zap_banner"
                android:fontFamily="monospace"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:lineSpacingExtra="1dp"
                android:visibility="gone" />

            <!-- Catch-up hint chip: shown when the focused channel has an archive. -->
            <TextView
                android:id="@+id/catchupHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="@dimen/space_m"
                android:background="@drawable/bg_badge_catchup"
                android:drawablePadding="@dimen/space_s"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/space_m"
                android:paddingVertical="@dimen/space_s"
                android:text="@string/catchup_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_catchup"
                android:visibility="gone" />

            <!-- Bottom caption: number + name + current program -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_preview_caption"
                android:paddingHorizontal="@dimen/space_l"
                android:paddingVertical="@dimen/space_m">

                <TextView
                    android:id="@+id/previewNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_big_title"
                    android:textStyle="bold"
                    android:layout_marginEnd="@dimen/space_l" />

                <ImageView
                    android:id="@+id/previewCaptionLogo"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="@dimen/space_m"
                    android:contentDescription="@string/now_playing" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/previewTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/previewProgram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption"
                        android:layout_marginTop="2dp"
                        android:maxLines="1"
                        android:ellipsize="end" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- EPG schedule for the previewed channel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:layout_marginTop="@dimen/space_m">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/epgList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:focusable="false" />

            <TextView
                android:id="@+id/epgEmpty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/no_guide"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
