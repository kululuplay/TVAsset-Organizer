<?xml version="1.0" encoding="utf-8"?>
<!-- Post-login launcher home, redesigned reference-style. A slim brand bar (logo +
     name on the left, a network-signal chip and Refresh on the right). Below it a
     hero header that pairs a left-aligned "what to watch?" prompt with a large,
     right-aligned clock/date and weather read-out (the signature element). Then two
     rows of gradient destination cards (Live hero / Movies / Series / Radio, and
     Favorites / Continue / Search / Settings) covering every section. Footer keeps
     the contact chips, account and version. Fully D-pad driven; cards scale + show a
     brand-pink ring on focus. All view IDs are preserved for DashboardActivity. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <!-- ===== Top bar: brand (left) + status cluster (right) ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand -->
        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_logo_badge"
            android:padding="9dp"
            android:src="@drawable/ic_tv"
            app:tint="@color/text_primary"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:letterSpacing="0.01"
            android:layout_marginStart="@dimen/space_m" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Weather pill (moved up next to the status cluster) -->
        <LinearLayout
            android:id="@+id/weatherChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_time_chip"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_m">

            <ImageView
                android:id="@+id/weatherIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_weather_clouds"
                app:tint="@color/text_primary"
                android:contentDescription="@string/weather_unavailable" />

            <TextView
                android:id="@+id/weatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/weather_unavailable"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Date pill -->
        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_time_chip"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_m"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:maxLines="1" />

        <!-- Network signal chip -->
        <LinearLayout
            android:id="@+id/signalChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_time_chip"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_m">

            <ImageView
                android:id="@+id/signalIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_signal"
                app:tint="@color/success"
                android:contentDescription="@string/signal_good" />

            <TextView
                android:id="@+id/signalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Refresh -->
        <ImageButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.Iptv.IconButton"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/action_refresh" />
    </LinearLayout>

    <!-- ===== Scrollable body ===== -->
    <ScrollView
        android:id="@+id/scrollBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_l"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Hero header: prompt (left) + big clock/weather read-out (right) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:baselineAligned="false">

                <!-- Prompt -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/dash_prompt_title"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_big_title"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:text="@string/dash_prompt_subtitle"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <!-- Clock read-out: hidden by default; the user turns it on in
                     Settings (weather + date now live in the top status cluster). -->
                <com.iptv.player.ui.common.ClockView
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:layout_marginStart="@dimen/space_l"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_clock"
                    android:textStyle="bold"
                    android:letterSpacing="0.01"
                    android:includeFontPadding="false" />
            </LinearLayout>

            <!-- Primary row: content destinations, with Live TV as a wide hero. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_l">

                <include
                    android:id="@+id/tileLive"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileMovies"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileSeries"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileRadio"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Secondary row: personal + utility destinations, five even cards.
                 Taller than the primary cards' label area so two-line titles
                 ("İzlemeye Devam Et", "İstek & Şikayet") never clip. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_m">

                <include
                    android:id="@+id/tileFavorites"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileContinue"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileSearch"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileSettings"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileRequest"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Footer: contact (left) + account & version (right) ===== -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/space_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Website chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_time_chip"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_globe"
                app:tint="@color/accent_cyan"
                android:contentDescription="@string/dash_website" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/dash_website"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- WhatsApp chip -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_time_chip"
            android:layout_marginStart="@dimen/space_s"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_whatsapp"
                app:tint="@color/accent_emerald"
                android:contentDescription="@string/dash_whatsapp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/dash_whatsapp"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Account + app version -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/footerUser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="2dp">

                <TextView
                    android:id="@+id/footerExpiry"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />

                <TextView
                    android:id="@+id/footerVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/text_caption" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Floating connectivity/outage banner (bottom-center pill). Shown when the
         device is offline (cached content) or the portal is unreachable and the
         Dashboard is auto-retrying; hidden the moment a sync succeeds. Overlaid
         so it never shifts the existing layout. Wired in DashboardActivity. -->
    <TextView
        android:id="@+id/statusBanner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_time_chip"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_s"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:visibility="gone"
        android:elevation="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
