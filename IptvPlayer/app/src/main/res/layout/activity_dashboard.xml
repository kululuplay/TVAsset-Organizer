<?xml version="1.0" encoding="utf-8"?>
<!-- Modern post-login launcher. Top bar: brand (left) + a status cluster (right)
     with a network-signal chip, the live clock/date, a real-weather pill and the
     Refresh/Exit actions. Body (scrollable): a centered "what to watch?" prompt,
     a primary row of five gradient cards (Live / Movies / Series / Settings /
     Favorites) and a secondary row (Continue / Playlists / Search / Account) -
     every existing destination is kept. Below them a "Newly added" horizontal
     poster rail (hidden until it has content). Footer: active source + expiry.
     Fully D-pad driven; cards scale + brand-pink ring on focus. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <!-- ===== Top bar ===== -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Brand -->
        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_logo_badge"
            android:padding="8dp"
            android:src="@drawable/ic_tv"
            android:tint="@color/text_primary"
            android:contentDescription="@string/app_name" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:layout_marginStart="@dimen/space_s" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Network signal chip -->
        <LinearLayout
            android:id="@+id/signalChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_time_chip"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_m">

            <ImageView
                android:id="@+id/signalIcon"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_signal"
                android:tint="@color/success"
                android:contentDescription="@string/signal_good" />

            <TextView
                android:id="@+id/signalText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Clock + date -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end"
            android:layout_marginEnd="@dimen/space_m">

            <com.iptv.player.ui.common.ClockView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_big_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/dateText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <!-- Weather pill -->
        <LinearLayout
            android:id="@+id/weatherPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_time_chip"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_s"
            android:layout_marginEnd="@dimen/space_m">

            <ImageView
                android:id="@+id/weatherIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_weather_clouds"
                android:tint="@color/text_primary"
                android:contentDescription="@string/weather_unavailable" />

            <TextView
                android:id="@+id/weatherText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:text="@string/weather_unavailable"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:maxLines="1" />
        </LinearLayout>

        <!-- Actions -->
        <ImageButton
            android:id="@+id/btnRefresh"
            style="@style/Widget.Iptv.IconButton"
            android:src="@drawable/ic_refresh"
            android:contentDescription="@string/action_refresh" />

        <ImageButton
            android:id="@+id/btnExit"
            style="@style/Widget.Iptv.IconButton"
            android:layout_marginStart="@dimen/space_s"
            android:src="@drawable/ic_power"
            android:contentDescription="@string/action_exit" />
    </LinearLayout>

    <!-- ===== Scrollable body ===== -->
    <ScrollView
        android:id="@+id/scrollBody"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toTopOf="@id/footer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Prompt -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:text="@string/dash_prompt_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_big_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:gravity="center"
                android:text="@string/dash_prompt_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <!-- Primary card row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="168dp"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_l">

                <include
                    android:id="@+id/tileLive"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileMovies"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileSeries"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileSettings"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileFavorites"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Secondary card row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="132dp"
                android:orientation="horizontal"
                android:layout_marginTop="@dimen/space_m">

                <include
                    android:id="@+id/tileContinue"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tilePlaylists"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileSearch"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:layout_marginEnd="@dimen/space_m" />

                <include
                    android:id="@+id/tileAccount"
                    layout="@layout/item_dashboard_card"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1" />
            </LinearLayout>

            <!-- Newly added rail (hidden until populated) -->
            <LinearLayout
                android:id="@+id/newlyAddedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/space_l"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dash_newly_added"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body"
                    android:textStyle="bold"
                    android:layout_marginBottom="@dimen/space_s" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/newlyAddedRail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:nestedScrollingEnabled="false"
                    android:focusable="false" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- ===== Footer ===== -->
    <LinearLayout
        android:id="@+id/footer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/space_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/footerSource"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/footerExpiry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
