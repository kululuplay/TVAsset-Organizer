<?xml version="1.0" encoding="utf-8"?>
<!-- Content manager hub row: leading icon + title/subtitle + trailing arrow.
     Focusable; turns white on focus (children duplicateParentState so they
     recolor with the row). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/settings_row_min_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_settings_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_s">

    <ImageView
        android:id="@+id/csIcon"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:duplicateParentState="true"
        android:contentDescription="@null"
        app:tint="@color/settings_row_text"
        xmlns:app="http://schemas.android.com/apk/res-auto" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/space_m"
        android:orientation="vertical">

        <TextView
            android:id="@+id/csTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textColor="@color/settings_row_text"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/csSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:duplicateParentState="true"
            android:textColor="@color/settings_row_text"
            android:alpha="0.7"
            android:textSize="@dimen/text_caption" />
    </LinearLayout>

    <ImageView
        android:id="@+id/csArrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:duplicateParentState="true"
        android:contentDescription="@null"
        android:src="@drawable/ic_arrow_right"
        app:tint="@color/settings_row_text"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
