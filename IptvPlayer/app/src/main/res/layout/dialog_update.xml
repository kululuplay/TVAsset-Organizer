<?xml version="1.0" encoding="utf-8"?>
<!-- Compact TV-safe update prompt. The launch dialog deliberately shows only a
     short localized summary so actions remain visible on low-height OEM screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/updateRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_update_dialog_modern"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_onboarding_step_icon"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="14dp"
            android:src="@drawable/ic_update" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:maxLines="1"
                android:text="@string/update_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/brand_pink"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/update_available_title"
                android:textColor="@color/text_primary"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/updateMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/updateVersion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:background="@drawable/bg_update_version_chip"
            android:gravity="center"
            android:maxLines="1"
            android:minHeight="38dp"
            android:paddingStart="@dimen/space_m"
            android:paddingEnd="@dimen/space_m"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_update_trust_strip"
        android:drawableStart="@drawable/ic_lock"
        android:drawablePadding="@dimen/space_s"
        android:gravity="center_vertical"
        android:minHeight="40dp"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:text="@string/update_secure_delivery"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <FrameLayout
        android:id="@+id/updateNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_update_notes_panel"
        android:focusable="false"
        android:focusableInTouchMode="false"
        android:padding="12dp">

        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:clipChildren="false"
        android:gravity="center"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/updateLaterButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_marginEnd="@dimen/space_m"
            android:layout_weight="1"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@id/updateLaterButton"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:stateListAnimator="@animator/control_focus"
            android:text="@string/update_remind_later"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/updateNowButton"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_update"
            android:drawablePadding="@dimen/space_s"
            android:focusable="true"
            android:gravity="center"
            android:nextFocusUp="@id/updateNowButton"
            android:paddingStart="@dimen/space_l"
            android:paddingEnd="@dimen/space_l"
            android:stateListAnimator="@animator/control_focus"
            android:text="@string/about_update_now"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
