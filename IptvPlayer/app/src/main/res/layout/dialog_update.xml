<?xml version="1.0" encoding="utf-8"?>
<!-- Modern launch-time "update available" prompt. Brand badge + version chip,
     optional release notes, and two CTAs: remind later (secondary) and update
     now (primary). All buttons are D-pad focusable for TV. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="520dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog"
    android:gravity="center_horizontal"
    android:padding="@dimen/space_l">

    <ImageView
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:background="@drawable/bg_logo_badge"
        android:padding="20dp"
        android:src="@drawable/ic_update"
        android:contentDescription="@null"
        android:tint="@color/text_primary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/update_available_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/updateVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:background="@drawable/bg_pill_dark"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="6dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/updateMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/update_available_message"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:gravity="center" />

    <ScrollView
        android:id="@+id/updateNotesScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:maxHeight="160dp"
        android:fadeScrollbars="false"
        android:visibility="gone">

        <TextView
            android:id="@+id/updateNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:lineSpacingMultiplier="1.15" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/updateLaterButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/space_m"
            android:background="@drawable/bg_button"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_m"
            android:text="@string/update_remind_later"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body" />

        <TextView
            android:id="@+id/updateNowButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_button_primary"
            android:drawableStart="@drawable/ic_update"
            android:drawablePadding="@dimen/space_s"
            android:focusable="true"
            android:gravity="center"
            android:paddingHorizontal="@dimen/space_l"
            android:paddingVertical="@dimen/space_m"
            android:text="@string/about_update_now"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
