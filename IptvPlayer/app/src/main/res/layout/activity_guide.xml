<?xml version="1.0" encoding="utf-8"?>
<!-- TV guide: top bar (title + now + clock/date + refresh) | channel column
     (left) + horizontal program timeline (right). Styled to match Live TV. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_m"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/nowIndicator"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/space_l"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />

        <com.iptv.player.ui.common.ClockView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body"
            android:layout_marginStart="@dimen/space_m"
            android:layout_marginEnd="@dimen/space_l" />

        <ProgressBar
            android:id="@+id/refreshProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/space_m"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnRefresh"
            style="@style/Widget.Iptv.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/guide_refresh" />
    </LinearLayout>

    <!-- Left: channel column -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/channelList"
        android:layout_width="@dimen/epg_channel_col"
        android:layout_height="0dp"
        android:background="@drawable/bg_glass_card"
        android:padding="@dimen/space_m"
        android:clipToPadding="false"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right: focused-channel timeline -->
    <LinearLayout
        android:id="@+id/timelinePanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/space_m"
        android:background="@drawable/bg_glass_card"
        android:padding="@dimen/space_m"
        app:layout_constraintStart_toEndOf="@id/channelList"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/focusedChannelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginBottom="@dimen/space_m" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/epg_row_height">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/programList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false" />

            <TextView
                android:id="@+id/emptyGuide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|start"
                android:text="@string/guide_no_data"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
