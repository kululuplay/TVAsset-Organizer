<?xml version="1.0" encoding="utf-8"?>
<!-- Compact TV category row with a persistent selected state and vivid D-pad focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:background="@drawable/bg_live_list_row"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:minHeight="54dp"
    android:orientation="horizontal"
    android:paddingEnd="12dp"
    android:stateListAnimator="@animator/control_focus">

    <View
        android:layout_width="4dp"
        android:layout_height="28dp"
        android:layout_marginEnd="12dp"
        android:background="@drawable/bg_live_category_indicator"
        android:duplicateParentState="true" />

    <TextView
        android:id="@+id/categoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/live_row_text"
        android:textSize="17sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/categoryCount"
        android:layout_width="wrap_content"
        android:layout_height="28dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_live_count_chip"
        android:duplicateParentState="true"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:minWidth="38dp"
        android:paddingHorizontal="8dp"
        android:textColor="@color/live_row_text_dim"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="5dp"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_arrow_right"
        app:tint="@color/live_row_text_dim" />
</LinearLayout>
