<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV category row: name (left) + channel count (right) on a dark rounded
     card. Focused = solid white card with dark text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_list_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/categoryTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@color/list_row_text"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/categoryCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/list_row_text_dim"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/space_s" />
</LinearLayout>
