<?xml version="1.0" encoding="utf-8"?>
<!-- One selectable option row. Purple highlight on focus (bg_row); accent check
     marks the current selection. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/dialog_option_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/optionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:maxLines="1"
        android:ellipsize="end" />

    <ImageView
        android:id="@+id/optionCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="@dimen/space_m"
        android:src="@drawable/ic_check"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
