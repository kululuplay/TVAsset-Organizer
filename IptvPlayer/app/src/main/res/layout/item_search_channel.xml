<?xml version="1.0" encoding="utf-8"?>
<!-- Search-only Live TV result. One focus target with merged semantics. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:layout_marginStart="3dp"
    android:layout_marginTop="3dp"
    android:layout_marginEnd="3dp"
    android:layout_marginBottom="5dp"
    android:background="@drawable/bg_search_channel_item"
    android:clickable="true"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingStart="9dp"
    android:paddingTop="7dp"
    android:paddingEnd="9dp"
    android:paddingBottom="7dp"
    android:stateListAnimator="@animator/control_focus">

    <TextView
        android:id="@+id/searchChannelNumber"
        android:layout_width="38dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_search_count_chip"
        android:gravity="center"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_small"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <FrameLayout
        android:id="@+id/searchChannelLogoFrame"
        android:layout_width="52dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_search_logo_plate"
        android:importantForAccessibility="noHideDescendants"
        android:padding="5dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/searchChannelNumber"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/searchChannelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/searchChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@id/searchChannelCategory"
        app:layout_constraintEnd_toStartOf="@id/searchChannelCatchup"
        app:layout_constraintStart_toEndOf="@id/searchChannelLogoFrame"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed" />

    <TextView
        android:id="@+id/searchChannelCategory"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:layout_marginStart="10dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/searchChannelCatchup"
        app:layout_constraintStart_toEndOf="@id/searchChannelLogoFrame"
        app:layout_constraintTop_toBottomOf="@id/searchChannelName" />

    <ImageView
        android:id="@+id/searchChannelCatchup"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginEnd="5dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_catchup"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/searchChannelFavorite"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/accent_cyan" />

    <ImageView
        android:id="@+id/searchChannelFavorite"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_star"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
