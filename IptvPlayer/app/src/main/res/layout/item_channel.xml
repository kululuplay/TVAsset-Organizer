<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV channel row: number + logo + name on a dark rounded card. Focused =
     solid white card with dark text. Long-press OK toggles favorite.
     Sizes are slightly smaller than the shared list dimens (explicit dp/sp here,
     not @dimen) so only the live channel list is more compact — it looked a touch
     zoomed-in at the shared sizes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="48dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_list_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="6dp"
    android:layout_marginBottom="6dp">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="44dp"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:duplicateParentState="true"
        android:textColor="@color/list_row_text_dim"
        android:textSize="17sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="@dimen/space_s"
        android:contentDescription="@string/now_playing" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@color/list_row_text"
        android:textSize="17sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/space_s" />

    <ImageView
        android:id="@+id/catchupBadge"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_catchup"
        android:layout_marginStart="@dimen/space_s"
        android:visibility="gone"
        android:contentDescription="@string/catchup_title" />

    <ImageView
        android:id="@+id/favStar"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_star"
        android:layout_marginStart="@dimen/space_s"
        android:visibility="gone"
        android:contentDescription="@string/section_favorites" />

    <!-- Kept for code compatibility; no longer shown in the redesigned row. -->
    <TextView
        android:id="@+id/channelProgram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
