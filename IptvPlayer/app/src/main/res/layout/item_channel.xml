<?xml version="1.0" encoding="utf-8"?>
<!-- Dense channel row sized for weak TV sticks and long D-pad lists. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="7dp"
    android:background="@drawable/bg_live_list_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingHorizontal="9dp"
    android:paddingVertical="6dp"
    android:stateListAnimator="@animator/control_focus">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="40dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_channel_number_chip"
        android:duplicateParentState="true"
        android:gravity="center"
        android:textColor="@color/live_row_text"
        android:textSize="14sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="50dp"
        android:layout_height="44dp"
        android:layout_marginHorizontal="8dp"
        android:background="@drawable/bg_channel_logo_plate"
        android:duplicateParentState="true"
        android:padding="5dp">

        <ImageView
            android:id="@+id/channelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/now_playing"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/channelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/live_row_text"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/catchupBadge"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginStart="7dp"
        android:contentDescription="@string/catchup_title"
        android:src="@drawable/ic_catchup"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/favStar"
        android:layout_width="19dp"
        android:layout_height="19dp"
        android:layout_marginStart="7dp"
        android:contentDescription="@string/section_favorites"
        android:src="@drawable/ic_star"
        android:visibility="gone" />

    <!-- Preserved for adapter compatibility; program details live in the EPG pane. -->
    <TextView
        android:id="@+id/channelProgram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
