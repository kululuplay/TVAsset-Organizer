<?xml version="1.0" encoding="utf-8"?>
<!-- Live TV channel row: number + logo + name on a dark rounded card. Focused =
     solid white card with dark text. Long-press OK toggles favorite. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_list_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_s">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:gravity="start|center_vertical"
        android:duplicateParentState="true"
        android:textColor="@color/list_row_text_dim"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/channelLogo"
        android:layout_width="@dimen/channel_logo"
        android:layout_height="@dimen/channel_logo"
        android:scaleType="fitCenter"
        android:layout_marginHorizontal="@dimen/space_s"
        android:contentDescription="@string/now_playing" />

    <TextView
        android:id="@+id/channelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@color/list_row_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginStart="@dimen/space_s" />

    <ImageView
        android:id="@+id/favStar"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:src="@drawable/ic_star"
        android:layout_marginStart="@dimen/space_s"
        android:visibility="gone"
        android:contentDescription="@string/section_favorites" />

    <!-- Kept for code compatibility; no longer shown in the redesigned row. -->
    <TextView
        android:id="@+id/channelProgram"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone" />
</LinearLayout>
