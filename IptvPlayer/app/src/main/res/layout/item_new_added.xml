<?xml version="1.0" encoding="utf-8"?>
<!-- "Newly added" rail card: poster artwork with a small NEW badge in the corner
     and the title below. Fixed width so it lays out in a horizontal rail.
     Focusable for D-pad; scales on focus. Clicking opens the detail screen. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="118dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_poster"
    android:foreground="@drawable/bg_tile_focus"
    android:stateListAnimator="@animator/tile_focus"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/space_s"
    android:layout_marginEnd="@dimen/space_s">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="153dp">

        <ImageView
            android:id="@+id/newPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/dash_newly_added" />

        <TextView
            android:id="@+id/newBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_xs"
            android:background="@drawable/bg_new_badge"
            android:paddingHorizontal="@dimen/space_s"
            android:paddingVertical="2dp"
            android:text="@string/dash_new_badge"
            android:textColor="@color/text_primary"
            android:textSize="10sp"
            android:textStyle="bold" />
    </FrameLayout>

    <TextView
        android:id="@+id/newTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
