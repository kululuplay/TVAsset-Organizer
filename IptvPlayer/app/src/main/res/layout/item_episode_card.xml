<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-size TV episode card. Stable dimensions prevent a long title or missing
     image from changing rail height and moving the D-pad target. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="210dp"
    android:layout_height="178dp"
    android:layout_marginEnd="10dp"
    android:background="@drawable/bg_series_episode_card"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:orientation="vertical"
    android:padding="6dp"
    android:stateListAnimator="@animator/control_focus">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="108dp"
        android:background="@drawable/bg_series_art_frame"
        android:clipToOutline="true"
        android:importantForAccessibility="noHideDescendants">

        <ImageView
            android:id="@+id/episodeThumb"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim_bottom"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/episodeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressTint="@color/brand_pink"
            android:progressBackgroundTint="@color/progress_track"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/episodeWatched"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:padding="3dp"
            android:src="@drawable/ic_check"
            android:background="@drawable/bg_series_meta_chip"
            app:tint="@color/accent_emerald"
            android:visibility="gone"
            android:contentDescription="@string/cd_watched" />
    </FrameLayout>

    <TextView
        android:id="@+id/episodeNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/brand_pink"
        android:textSize="@dimen/text_small"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/episodeTitle"
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
