<?xml version="1.0" encoding="utf-8"?>
<!-- Episode card for the horizontal series rail: 16:9 thumbnail with a resume
     bar, season/episode caption and title. Focusable for D-pad. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="220dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_poster"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/space_s"
    android:layout_marginEnd="@dimen/space_s">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/episodeThumb"
            android:layout_width="match_parent"
            android:layout_height="118dp"
            android:scaleType="centerCrop"
            android:contentDescription="@string/nav_series" />

        <ProgressBar
            android:id="@+id/episodeProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressTint="@color/accent"
            android:progressBackgroundTint="@color/bg_card_focused"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/episodeWatched"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_xs"
            android:padding="3dp"
            android:src="@drawable/ic_check"
            android:background="@drawable/bg_time_chip"
            android:tint="@color/accent"
            android:visibility="gone"
            android:contentDescription="@string/cd_watched" />
    </FrameLayout>

    <TextView
        android:id="@+id/episodeNumber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:maxLines="1" />

    <TextView
        android:id="@+id/episodeTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
