<?xml version="1.0" encoding="utf-8"?>
<!-- Series-only catalog card. Fixed metadata heights keep every grid row aligned
     while the strong focus ring remains visible from TV viewing distance. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="3dp"
    android:background="@drawable/bg_series_poster_card"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="5dp"
    android:stateListAnimator="@animator/control_focus">

    <FrameLayout
        android:id="@+id/seriesArtworkFrame"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_series_art_frame"
        android:clipToOutline="true"
        android:importantForAccessibility="noHideDescendants"
        app:layout_constraintDimensionRatio="H,2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/posterImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_gravity="bottom"
            android:background="@drawable/bg_scrim_bottom"
            android:importantForAccessibility="no" />

        <ProgressBar
            android:id="@+id/posterProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="5dp"
            android:layout_gravity="bottom"
            android:max="100"
            android:progressBackgroundTint="@color/progress_track"
            android:progressTint="@color/brand_pink"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/posterRatingRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="7dp"
            android:background="@drawable/bg_series_meta_chip"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="7dp"
            android:paddingTop="3dp"
            android:paddingEnd="7dp"
            android:paddingBottom="3dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:layout_marginEnd="3dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_star"
                app:tint="@color/star" />

            <TextView
                android:id="@+id/posterRating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/posterName"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/seriesArtworkFrame" />

    <TextView
        android:id="@+id/posterMeta"
        android:layout_width="0dp"
        android:layout_height="18dp"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_small"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/posterName" />
</androidx.constraintlayout.widget.ConstraintLayout>
