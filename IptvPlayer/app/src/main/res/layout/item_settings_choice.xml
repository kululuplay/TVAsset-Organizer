<?xml version="1.0" encoding="utf-8"?>
<!-- A detail-panel selectable row: title plus an optional trailing icon (language
     flag, navigation arrow or a check mark). Focusable; turns white on focus. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/settings_row_min_h"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_settings_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_s">

    <TextView
        android:id="@+id/cTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:textColor="@color/settings_row_text"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/cIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:duplicateParentState="true"
        android:contentDescription="@null"
        android:visibility="gone" />
</LinearLayout>
