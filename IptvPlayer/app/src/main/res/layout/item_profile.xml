<?xml version="1.0" encoding="utf-8"?>
<!-- Profile row: name + source summary, with an "Active" badge for the selected
     profile. Focusable for D-pad navigation. Click switches, long-press deletes. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/space_m"
    android:layout_marginBottom="@dimen/space_xs">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/profileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/profileSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:layout_marginTop="@dimen/space_xs"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <TextView
        android:id="@+id/profileActiveBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/profile_active"
        android:textColor="@color/success"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        android:layout_marginStart="@dimen/space_m"
        android:visibility="gone" />
</LinearLayout>
