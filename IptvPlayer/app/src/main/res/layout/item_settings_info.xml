<?xml version="1.0" encoding="utf-8"?>
<!-- A read-only label/value row used inside the General Info panel. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="#10FFFFFF"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_m"
    android:layout_marginBottom="2dp">

    <TextView
        android:id="@+id/iLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body" />

    <TextView
        android:id="@+id/iValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_m"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold"
        android:gravity="end" />
</LinearLayout>
