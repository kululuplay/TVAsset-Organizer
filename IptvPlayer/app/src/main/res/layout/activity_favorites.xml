<?xml version="1.0" encoding="utf-8"?>
<!-- Responsive TV collection surface: clear remote guidance, item count and a
     single state panel for loading, empty and recoverable error states. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_collections_root"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_collection_header"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/space_m">

        <ImageView
            android:layout_width="@dimen/collection_header_icon"
            android:layout_height="@dimen/collection_header_icon"
            android:background="@drawable/bg_badge_favorites"
            android:contentDescription="@null"
            android:padding="@dimen/space_m"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_heart_filled"
            app:tint="@color/text_primary" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/screenTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/section_favorites"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/collections_favorites_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <TextView
            android:id="@+id/collectionCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_l"
            android:background="@drawable/bg_collection_count"
            android:gravity="center"
            android:minHeight="40dp"
            android:paddingHorizontal="@dimen/space_m"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:visibility="invisible" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:layout_weight="1"
        android:background="@drawable/bg_collection_grid_panel"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:padding="@dimen/space_s">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/favoritesGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:descendantFocusability="afterDescendants"
            android:padding="@dimen/space_s"
            android:scrollbars="none"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/stateContainer"
            android:layout_width="460dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_collection_state"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <ImageView
                android:id="@+id/stateIcon"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/bg_badge_favorites"
                android:contentDescription="@null"
                android:padding="@dimen/space_m"
                android:src="@drawable/ic_heart_filled"
                android:visibility="gone"
                app:tint="@color/text_primary" />

            <ProgressBar
                android:id="@+id/stateProgress"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/brand_pink" />

            <TextView
                android:id="@+id/stateTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:text="@string/loading"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/emptyText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:text="@string/favorites_empty"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption"
                android:visibility="gone" />

            <TextView
                android:id="@+id/retryButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_settings_action"
                android:clickable="true"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:gravity="center"
                android:minWidth="160dp"
                android:paddingHorizontal="@dimen/space_l"
                android:text="@string/action_retry"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_caption"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
