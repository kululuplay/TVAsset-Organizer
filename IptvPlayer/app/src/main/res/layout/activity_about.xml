<?xml version="1.0" encoding="utf-8"?>
<!-- About: app name, version and a (placeholder) update check. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:background="@color/bg_root"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_launcher"
        android:layout_marginTop="@dimen/space_xl"
        android:layout_marginBottom="@dimen/space_l"
        android:contentDescription="@string/app_name" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_big_title"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/aboutVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_body"
        android:layout_marginTop="@dimen/space_s" />

    <TextView
        android:id="@+id/aboutUpdateStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnCheckUpdate"
        style="@style/Widget.Iptv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:text="@string/about_check_update" />

    <Button
        android:id="@+id/btnUpdateNow"
        style="@style/Widget.Iptv.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:text="@string/about_update_now"
        android:visibility="gone" />
</LinearLayout>
