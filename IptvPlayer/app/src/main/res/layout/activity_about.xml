<?xml version="1.0" encoding="utf-8"?>
<!-- Modern Android TV About/update workspace with stable D-pad actions. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:orientation="vertical"
    android:paddingStart="@dimen/safe_area_h"
    android:paddingTop="@dimen/safe_area_v"
    android:paddingEnd="@dimen/safe_area_h"
    android:paddingBottom="@dimen/safe_area_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_support_icon_badge"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_update"
            app:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/aboutTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_big_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/about_subtitle"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_m"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:background="@drawable/bg_about_brand_panel"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <ImageView
                android:layout_width="132dp"
                android:layout_height="132dp"
                android:background="@drawable/bg_about_logo_plate"
                android:contentDescription="@string/app_name"
                android:padding="18dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:gravity="center"
                android:text="@string/app_name"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_big_title"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aboutVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:gravity="center"
                android:textColor="@color/accent"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:gravity="center"
                android:lineSpacingMultiplier="1.2"
                android:text="@string/about_brand_tagline"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <Space
            android:layout_width="@dimen/space_m"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="6"
            android:background="@drawable/bg_support_panel"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:padding="@dimen/space_l">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/about_update_section"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/about_update_desc"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />

            <TextView
                android:id="@+id/aboutUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:accessibilityLiveRegion="polite"
                android:gravity="start"
                android:minHeight="28dp"
                android:text="@string/about_ready"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <!-- Live download card: percent, progress, size, speed and ETA. -->
            <LinearLayout
                android:id="@+id/updateProgressCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_about_progress"
                android:orientation="vertical"
                android:padding="@dimen/space_m"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/updatePercent"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:includeFontPadding="false"
                        android:textColor="@color/accent"
                        android:textSize="42sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/updateDownloadingLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingBottom="5dp"
                        android:text="@string/about_download_started"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>

                <ProgressBar
                    android:id="@+id/updateProgressBar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_marginTop="@dimen/space_m"
                    android:contentDescription="@string/about_download_started"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/update_progress" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_m"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/updateSize"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="start"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_caption" />

                    <TextView
                        android:id="@+id/updateSpeedEta"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:background="@drawable/bg_support_action"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="@dimen/settings_row_min_h"
                android:nextFocusDown="@id/btnUpdateNow"
                android:stateListAnimator="@animator/control_focus"
                android:text="@string/about_check_update"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnUpdateNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_support_action"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="@dimen/settings_row_min_h"
                android:nextFocusUp="@id/btnCheckUpdate"
                android:stateListAnimator="@animator/control_focus"
                android:text="@string/about_update_now"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCancelUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_s"
                android:background="@drawable/bg_support_action"
                android:backgroundTint="@null"
                android:focusable="true"
                android:focusableInTouchMode="false"
                android:minHeight="@dimen/settings_row_min_h"
                android:stateListAnimator="@animator/control_focus"
                android:text="@string/about_download_cancel"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
