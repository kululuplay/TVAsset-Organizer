<?xml version="1.0" encoding="utf-8"?>
<!-- Screensaver: a logo + clock block that drifts around the screen to avoid
     burn-in. Any key press / touch dismisses it (handled in the Activity). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/screensaverRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora">

    <LinearLayout
        android:id="@+id/floatingBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_tv"
            android:layout_marginBottom="@dimen/space_s"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/screensaverClock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_big_title"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/screensaver_hint"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_caption"
            android:layout_marginTop="@dimen/space_s" />
    </LinearLayout>
</FrameLayout>
