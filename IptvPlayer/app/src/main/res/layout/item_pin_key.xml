<?xml version="1.0" encoding="utf-8"?>
<!-- One on-screen keypad key (digit or backspace). Focusable; white on focus. -->
<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/settings_pin_key"
    android:layout_height="@dimen/settings_pin_key"
    android:layout_marginEnd="@dimen/space_s"
    android:background="@drawable/bg_settings_row"
    android:gravity="center"
    android:textColor="@color/settings_row_text"
    android:textSize="@dimen/text_title"
    android:textStyle="bold"
    android:focusable="true"
    android:focusableInTouchMode="false" />
