<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:background="@drawable/bg_fullscreen_guide_row"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="8dp"
    android:paddingTop="5dp"
    android:paddingEnd="10dp"
    android:paddingBottom="5dp"
    android:stateListAnimator="@animator/control_focus">

    <TextView
        android:id="@+id/fullscreenGuideChannelNumber"
        android:layout_width="42dp"
        android:layout_height="34dp"
        android:background="@drawable/bg_channel_number_chip"
        android:duplicateParentState="true"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_channel_logo_plate"
        android:duplicateParentState="true"
        android:padding="5dp">

        <ImageView
            android:id="@+id/fullscreenGuideChannelLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/channels_title"
            android:scaleType="fitCenter" />
    </FrameLayout>

    <TextView
        android:id="@+id/fullscreenGuideChannelName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="@color/text_primary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/fullscreenGuideCatchup"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/catchup_title"
        android:src="@drawable/ic_catchup"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/fullscreenGuideFavorite"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="6dp"
        android:contentDescription="@string/section_favorites"
        android:src="@drawable/ic_star"
        android:visibility="gone" />

    <TextView
        android:id="@+id/fullscreenGuideLiveBadge"
        android:layout_width="wrap_content"
        android:layout_height="24dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/bg_epg_live_badge"
        android:gravity="center"
        android:paddingStart="7dp"
        android:paddingEnd="7dp"
        android:text="@string/live_label"
        android:textColor="@android:color/white"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
