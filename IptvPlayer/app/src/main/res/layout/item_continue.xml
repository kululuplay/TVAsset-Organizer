<?xml version="1.0" encoding="utf-8"?>
<!-- Continue card with responsive artwork, explicit content/progress chips and
     a high-contrast resume bar. All child semantics are merged into the root. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/bg_collection_card"
    android:clickable="true"
    android:clipChildren="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:importantForAccessibility="yes"
    android:longClickable="true"
    android:padding="@dimen/space_s"
    android:stateListAnimator="@animator/collection_card_focus">

    <FrameLayout
        android:id="@+id/continueArtwork"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_poster_artwork"
        android:clipToOutline="true"
        app:layout_constraintDimensionRatio="2:3"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/continuePoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/continueSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|start"
            android:layout_margin="@dimen/space_s"
            android:background="@drawable/bg_collection_chip"
            android:ellipsize="end"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:maxLines="1"
            android:paddingHorizontal="@dimen/space_s"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_small"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/continuePercent"
            android:layout_width="wrap_content"
            android:layout_height="28dp"
            android:layout_gravity="top|end"
            android:layout_margin="@dimen/space_s"
            android:background="@drawable/bg_collection_chip"
            android:gravity="center"
            android:importantForAccessibility="no"
            android:minWidth="44dp"
            android:paddingHorizontal="@dimen/space_s"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_small"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/continueProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_gravity="bottom"
            android:importantForAccessibility="no"
            android:max="100"
            android:progressDrawable="@drawable/progress_now" />
    </FrameLayout>

    <TextView
        android:id="@+id/continueTitle"
        android:layout_width="0dp"
        android:layout_height="@dimen/collection_card_text_height"
        android:layout_marginTop="@dimen/space_s"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/continueArtwork" />
</androidx.constraintlayout.widget.ConstraintLayout>
