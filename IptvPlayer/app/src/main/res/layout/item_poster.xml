<?xml version="1.0" encoding="utf-8"?>
<!-- Shared 10-foot poster card for movie, series and recommendation rails.
     The artwork is clipped independently from the focus surface so the focus
     ring stays crisp while low-resolution provider art never bleeds outside
     the rounded card. Child semantics are merged into the focusable root by
     the adapters, avoiding several TalkBack stops for a single title. -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_poster"
    android:clickable="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:descendantFocusability="blocksDescendants"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:stateListAnimator="@animator/control_focus"
    android:padding="6dp"
    android:layout_margin="@dimen/space_xs">

    <ImageView
        android:id="@+id/posterImage"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/bg_poster_artwork"
        android:clipToOutline="true"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="H,2:3" />

    <!-- A subtle play affordance appears only while the parent card is focused.
         duplicateParentState keeps this entirely drawable-driven and cheap on
         entry-level sticks (no per-card animation listeners). -->
    <ImageView
        android:id="@+id/posterPlayIndicator"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_poster_play_indicator"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="10dp"
        android:padding="10dp"
        android:src="@drawable/ic_play"
        app:tint="@color/poster_play_tint"
        app:layout_constraintBottom_toBottomOf="@id/posterImage"
        app:layout_constraintEnd_toEndOf="@id/posterImage" />

    <!-- Resume progress bar pinned to the bottom of the poster artwork. -->
    <ProgressBar
        android:id="@+id/posterProgress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:max="100"
        android:progressTint="@color/accent"
        android:progressBackgroundTint="@color/progress_track"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@id/posterImage"
        app:layout_constraintEnd_toEndOf="@id/posterImage"
        app:layout_constraintBottom_toBottomOf="@id/posterImage" />

    <!-- Watched (finished) tick, top-left of the poster artwork. -->
    <ImageView
        android:id="@+id/posterWatched"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:padding="3dp"
        android:src="@drawable/ic_check"
        android:background="@drawable/bg_poster_status_chip"
        app:tint="@color/accent"
        android:layout_margin="@dimen/space_xs"
        android:visibility="gone"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="@id/posterImage"
        app:layout_constraintStart_toStartOf="@id/posterImage" />

    <!-- Floating rating badge (top-right of the poster). -->
    <LinearLayout
        android:id="@+id/posterRatingRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_poster_status_chip"
        android:paddingHorizontal="@dimen/space_s"
        android:paddingVertical="3dp"
        android:layout_margin="@dimen/space_xs"
        android:visibility="gone"
        android:importantForAccessibility="no"
        app:layout_constraintTop_toTopOf="@id/posterImage"
        app:layout_constraintEnd_toEndOf="@id/posterImage">

        <ImageView
            android:id="@+id/posterStar"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:src="@drawable/ic_star"
            android:layout_marginEnd="2dp"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/posterRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_caption"
            android:textStyle="bold"
            android:maxLines="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/posterName"
        android:layout_width="0dp"
        android:layout_height="42dp"
        android:layout_marginTop="@dimen/space_s"
        android:ellipsize="end"
        android:gravity="top"
        android:importantForAccessibility="no"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/posterImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/posterMeta"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:minHeight="18dp"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_small"
        app:layout_constraintTop_toBottomOf="@id/posterName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
