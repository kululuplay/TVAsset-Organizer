<?xml version="1.0" encoding="utf-8"?>
<!-- Modern parental-gate PIN dialog: title, 4 display boxes, an inline error
     hint and an on-screen keypad. The keypad is built in code (PinPromptDialog)
     to reuse item_pin_box / item_pin_key. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="460dp"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pin_dialog"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_xl"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/space_xl"
    android:paddingBottom="@dimen/space_l">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_support_icon_badge"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:padding="12dp"
        android:src="@drawable/ic_lock"
        app:tint="@color/accent" />

    <TextView
        android:id="@+id/pinTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:gravity="center"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:text="@string/pin_enter" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:text="@string/settings_pin_remote_hint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption" />

    <LinearLayout
        android:id="@+id/pinBoxes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:layoutDirection="ltr"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/pinError"
        android:layout_width="match_parent"
        android:layout_height="24dp"
        android:layout_marginTop="@dimen/space_s"
        android:accessibilityLiveRegion="assertive"
        android:gravity="center"
        android:textColor="@color/danger"
        android:textSize="@dimen/text_caption"
        android:visibility="invisible"
        android:text="@string/pin_wrong" />

    <LinearLayout
        android:id="@+id/pinKeys"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:layoutDirection="ltr"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical" />
</LinearLayout>
