<?xml version="1.0" encoding="utf-8"?>
<!-- Episode row: number + title (+ plot). Focusable for D-pad navigation. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_selectable"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/episodeNumber"
        android:layout_width="48dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_body" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/space_s">

        <TextView
            android:id="@+id/episodeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/episodePlot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:maxLines="2"
            android:ellipsize="end"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
