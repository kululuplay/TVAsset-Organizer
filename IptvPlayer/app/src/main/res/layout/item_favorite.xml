<?xml version="1.0" encoding="utf-8"?>
<!-- Favorite card: poster/logo artwork, the title, and a small type label
     (Live / Movie / Series). Focusable for D-pad; clicking opens the matching
     player or detail screen for that content type. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="130dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_poster"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/space_s"
    android:layout_marginEnd="@dimen/space_s">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="180dp">

        <ImageView
            android:id="@+id/favPoster"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="@string/section_favorites" />
    </FrameLayout>

    <TextView
        android:id="@+id/favTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:maxLines="1"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/favType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
