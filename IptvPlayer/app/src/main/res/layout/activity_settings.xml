<?xml version="1.0" encoding="utf-8"?>
<!-- TV-first master/detail settings. Every panel root is a non-focusable scroll
     viewport below one shared, Activity-driven detail header. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_login_aurora"
    android:orientation="vertical"
    android:paddingStart="@dimen/safe_area_h"
    android:paddingTop="@dimen/safe_area_v"
    android:paddingEnd="@dimen/safe_area_h"
    android:paddingBottom="@dimen/safe_area_v">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/space_m"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.02"
            android:text="@string/settings_title"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_big_title"
            android:textStyle="bold" />

        <Space
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <com.iptv.player.ui.common.ClockView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/dateText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_m"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:orientation="horizontal">

        <!-- Category rail. The viewport cannot steal D-pad focus from its rows. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="5"
            android:background="@drawable/bg_settings_rail"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="@dimen/settings_rail_padding"
            android:paddingTop="@dimen/settings_rail_padding"
            android:paddingEnd="@dimen/settings_rail_padding"
            android:paddingBottom="@dimen/settings_rail_padding">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:fillViewport="true"
                android:focusable="false"
                android:focusableInTouchMode="false">

                <LinearLayout
                    android:id="@+id/settingsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:orientation="vertical" />
            </androidx.core.widget.NestedScrollView>
        </LinearLayout>

        <Space
            android:layout_width="@dimen/space_m"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:clipChildren="false"
            android:orientation="vertical">

            <!-- Shared header updated whenever the selected rail panel changes. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_s"
                android:background="@drawable/bg_settings_detail_header"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/settings_panel_padding"
                android:paddingTop="@dimen/space_m"
                android:paddingEnd="@dimen/settings_panel_padding"
                android:paddingBottom="@dimen/space_m">

                <ImageView
                    android:id="@+id/detailHeaderIcon"
                    android:layout_width="@dimen/settings_header_icon"
                    android:layout_height="@dimen/settings_header_icon"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:paddingStart="@dimen/space_s"
                    android:paddingTop="@dimen/space_s"
                    android:paddingEnd="@dimen/space_s"
                    android:paddingBottom="@dimen/space_s"
                    android:src="@drawable/ic_settings"
                    app:tint="@color/accent" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/space_m"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/detailTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_general_info"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_title"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_xs"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="@string/settings_panel_general_desc"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_caption" />
                </LinearLayout>
            </LinearLayout>

            <!-- Every ID here is a unique visible panel root controlled by Activity. -->
            <FrameLayout
                android:id="@+id/detailContainer"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:background="@drawable/bg_settings_panel"
                android:clipChildren="false"
                android:paddingStart="@dimen/settings_panel_padding"
                android:paddingTop="@dimen/settings_panel_padding"
                android:paddingEnd="@dimen/settings_panel_padding"
                android:paddingBottom="@dimen/settings_panel_padding">

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailGeneral"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false">

                    <LinearLayout
                        android:id="@+id/generalContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m" />
                </androidx.core.widget.NestedScrollView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/languageContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m" />
                </androidx.core.widget.NestedScrollView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailPin"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m">

                        <!-- Activity adds Lock Adult and Profiles rows here. -->
                        <LinearLayout
                            android:id="@+id/pinSettingsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:background="@drawable/bg_pin_setup_panel"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_l"
                            android:paddingTop="@dimen/space_l"
                            android:paddingEnd="@dimen/space_l"
                            android:paddingBottom="@dimen/space_l">

                            <ImageView
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/bg_support_icon_badge"
                                android:contentDescription="@null"
                                android:importantForAccessibility="no"
                                android:padding="@dimen/space_s"
                                android:src="@drawable/ic_lock"
                                app:tint="@color/accent" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:gravity="center"
                                android:text="@string/settings_pin_setup_desc"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />

                            <TextView
                                android:id="@+id/pinPrompt"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:accessibilityLiveRegion="polite"
                                android:gravity="center"
                                android:maxLines="2"
                                android:textColor="@color/text_primary"
                                android:textSize="@dimen/text_title"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:id="@+id/pinBoxes"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:layoutDirection="ltr"
                                android:orientation="horizontal" />

                            <LinearLayout
                                android:id="@+id/pinKeys"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:layoutDirection="ltr"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="vertical" />

                            <TextView
                                android:id="@+id/pinHint"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_s"
                                android:accessibilityLiveRegion="polite"
                                android:gravity="center"
                                android:maxLines="3"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_caption" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailCategories"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/categoriesContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m" />
                </androidx.core.widget.NestedScrollView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailPlayer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/playerContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m" />
                </androidx.core.widget.NestedScrollView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailTime"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/timeContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m" />
                </androidx.core.widget.NestedScrollView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailSpeedtest"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/speedtest_title"
                            android:textColor="@color/text_primary"
                            android:textSize="@dimen/text_title"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/speedtest_desc"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_caption" />

                        <TextView
                            android:id="@+id/speedMeta"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_s"
                            android:text="@string/speedtest_method"
                            android:textColor="@color/accent"
                            android:textSize="@dimen/text_small"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_xs"
                            android:text="@string/speedtest_data_notice"
                            android:textColor="@color/text_muted"
                            android:textSize="@dimen/text_small" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:background="@drawable/bg_settings_info_row"
                            android:gravity="center_horizontal"
                            android:orientation="vertical"
                            android:paddingStart="@dimen/space_l"
                            android:paddingTop="@dimen/space_l"
                            android:paddingEnd="@dimen/space_l"
                            android:paddingBottom="@dimen/space_l">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/speedResult"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:accessibilityLiveRegion="polite"
                                    android:includeFontPadding="false"
                                    android:text="@string/speedtest_idle"
                                    android:textColor="@color/text_primary"
                                    android:textSize="@dimen/settings_speed_result"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginStart="@dimen/space_s"
                                    android:layout_marginBottom="@dimen/space_s"
                                    android:text="@string/speedtest_unit"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="@dimen/text_title"
                                    android:textStyle="bold" />
                            </LinearLayout>

                            <ProgressBar
                                android:id="@+id/speedProgress"
                                style="?android:attr/progressBarStyleHorizontal"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/settings_progress_height"
                                android:layout_marginTop="@dimen/space_m"
                                android:contentDescription="@string/speedtest_progress"
                                android:indeterminate="false"
                                android:max="100"
                                android:progress="0"
                                android:progressDrawable="@drawable/progress_settings_speed"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/speedStatus"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/space_m"
                                android:accessibilityLiveRegion="polite"
                                android:gravity="center"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"
                                android:visibility="gone" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/speedStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/space_m"
                            android:background="@drawable/bg_settings_action"
                            android:backgroundTint="@null"
                            android:focusable="true"
                            android:focusableInTouchMode="false"
                            android:minHeight="@dimen/settings_row_min_h"
                            android:paddingStart="@dimen/space_xl"
                            android:paddingTop="@dimen/space_m"
                            android:paddingEnd="@dimen/space_xl"
                            android:paddingBottom="@dimen/space_m"
                            android:stateListAnimator="@animator/control_focus"
                            android:text="@string/speedtest_start"
                            android:textAllCaps="false"
                            android:textColor="@android:color/white"
                            android:textSize="@dimen/text_body"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <androidx.core.widget.NestedScrollView
                    android:id="@+id/detailSystem"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:fillViewport="true"
                    android:focusable="false"
                    android:focusableInTouchMode="false"
                    android:visibility="gone">

                    <LinearLayout
                        android:id="@+id/systemContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="@dimen/space_m" />
                </androidx.core.widget.NestedScrollView>
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
