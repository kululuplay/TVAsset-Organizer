<?xml version="1.0" encoding="utf-8"?>
<!-- Settings: a vertically scrollable, D-pad friendly list of rows. Rows and
     section headers are added programmatically into the container. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_root"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/settings_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_big_title"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/space_m" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:id="@+id/settingsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
