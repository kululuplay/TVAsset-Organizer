<?xml version="1.0" encoding="utf-8"?>
<!-- Fixed-height season chip: persistent selection and transient D-pad focus are
     visually distinct, so viewers always know which episode list is active. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="44dp"
    android:layout_marginEnd="8dp"
    android:background="@drawable/bg_series_season_chip"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:gravity="center"
    android:minWidth="100dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:stateListAnimator="@animator/control_focus">

    <TextView
        android:id="@+id/categoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:importantForAccessibility="no"
        android:textColor="@color/list_row_text"
        android:textSize="@dimen/detail_action_text"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />
</LinearLayout>
