<?xml version="1.0" encoding="utf-8"?>
<!-- Season chip for the horizontal season selector. Dark rounded card; focused
     or selected = solid white card with dark text. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/bg_list_row"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:minWidth="100dp"
    android:paddingHorizontal="@dimen/space_m"
    android:paddingVertical="@dimen/space_s"
    android:layout_marginEnd="@dimen/space_s">

    <TextView
        android:id="@+id/categoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:duplicateParentState="true"
        android:textColor="@color/list_row_text"
        android:textSize="@dimen/detail_action_text"
        android:textStyle="bold"
        android:maxLines="1" />
</LinearLayout>
