<?xml version="1.0" encoding="utf-8"?>
<!-- Content manager hub: pick Live TV / Movies / Series to edit categories and
     (for Live) channels. Rows are added programmatically. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_login_aurora"
    android:paddingHorizontal="@dimen/safe_area_h"
    android:paddingVertical="@dimen/safe_area_v">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/content_manager_title"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_title"
        android:textStyle="bold"
        android:layout_marginBottom="@dimen/space_xs" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/content_manager_hint"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_caption"
        android:layout_marginBottom="@dimen/space_l" />

    <LinearLayout
        android:id="@+id/sectionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
