<?xml version="1.0" encoding="utf-8"?>
<!-- Widescreen content-management hub. The editorial panel explains the task;
     the compact rail keeps all three destinations visible without scrolling. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_content_manager_root"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/safe_area_h"
        android:paddingVertical="@dimen/safe_area_v">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="4"
            android:background="@drawable/bg_content_manager_panel"
            android:clipChildren="false"
            android:orientation="vertical"
            android:padding="@dimen/space_xl">

            <ImageView
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_badge_settings"
                android:contentDescription="@null"
                android:padding="@dimen/space_m"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_sort"
                app:tint="@color/text_primary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_l"
                android:importantForAccessibility="no"
                android:letterSpacing="0.18"
                android:text="@string/content_manager_overline"
                android:textAllCaps="true"
                android:textColor="@color/brand_pink"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/cmHubTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_xs"
                android:text="@string/content_manager_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_big_title"
                android:textStyle="bold" />

            <View
                android:layout_width="96dp"
                android:layout_height="3dp"
                android:layout_marginTop="@dimen/space_m"
                android:background="@drawable/bg_hairline_gradient"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_m"
                android:lineSpacingExtra="3dp"
                android:text="@string/content_manager_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body" />

            <Space
                android:layout_width="1dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:importantForAccessibility="no" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_content_manager_hint"
                android:lineSpacingExtra="2dp"
                android:padding="@dimen/space_m"
                android:text="@string/settings_content_manager_hint"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_xl"
            android:layout_weight="6"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_s"
                android:letterSpacing="0.14"
                android:text="@string/content_manager_overline"
                android:textAllCaps="true"
                android:textColor="@color/live_cyan"
                android:textSize="@dimen/text_small"
                android:textStyle="bold" />

            <View
                android:layout_width="match_parent"
                android:layout_height="2dp"
                android:layout_marginHorizontal="@dimen/space_s"
                android:layout_marginTop="@dimen/space_s"
                android:layout_marginBottom="@dimen/space_m"
                android:background="@drawable/bg_hairline_gradient"
                android:importantForAccessibility="no" />

            <LinearLayout
                android:id="@+id/sectionContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
