<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable dashboard destination card: a gradient icon badge over a title and
     a short subtitle, centered on a dark glass surface. The icon badge, title and
     subtitle are filled in per destination from code. Focusable for D-pad; scales
     and shows a brand-pink ring on focus. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tile_surface"
    android:foreground="@drawable/bg_tile_focus"
    android:stateListAnimator="@animator/tile_focus"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="@dimen/space_m">

        <ImageView
            android:id="@+id/cardIcon"
            android:layout_width="@dimen/badge_medium"
            android:layout_height="@dimen/badge_medium"
            android:background="@drawable/bg_badge_live"
            android:padding="@dimen/space_m"
            android:src="@drawable/ic_tv"
            android:tint="@color/text_primary"
            android:contentDescription="@string/nav_live" />

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</FrameLayout>
