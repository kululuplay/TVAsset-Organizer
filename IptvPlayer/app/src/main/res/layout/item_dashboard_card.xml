<?xml version="1.0" encoding="utf-8"?>
<!-- Editorial destination card for the TV dashboard. A low-opacity oversized
     glyph creates depth, while the real icon, label and text stay crisp. The
     hero card is enlarged at runtime without changing this reusable structure. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tile_surface"
    android:clickable="true"
    android:clipChildren="false"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:foreground="@drawable/bg_dashboard_tile_focus"
    android:stateListAnimator="@animator/dashboard_tile_focus">

    <ImageView
        android:id="@+id/cardWatermark"
        android:layout_width="104dp"
        android:layout_height="104dp"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="-12dp"
        android:layout_marginBottom="-14dp"
        android:alpha="0.07"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_tv"
        app:tint="@color/text_primary" />

    <LinearLayout
        android:id="@+id/cardContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="10dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/cardIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_badge_live"
                android:contentDescription="@string/nav_live"
                android:padding="8dp"
                android:src="@drawable/ic_tv"
                app:tint="@color/text_primary" />

            <TextView
                android:id="@+id/cardEyebrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_m"
                android:background="@drawable/bg_live_badge"
                android:paddingHorizontal="@dimen/space_s"
                android:paddingVertical="@dimen/space_xs"
                android:text="@string/live_label"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_small"
                android:textStyle="bold"
                android:visibility="gone" />

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:alpha="0.72"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="2"
            android:textColor="@color/text_primary"
            android:textSize="17sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/cardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="start"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>
</FrameLayout>
