<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable dashboard destination card, editorial-style: a gradient icon badge
     anchored top-left, the title and short subtitle pinned bottom-left, and a faint
     "open" chevron in the bottom-right corner as a D-pad affordance. The icon badge,
     title, subtitle (and, for the hero tile, the surface) are filled in per
     destination from code. Focusable for D-pad; scales and shows a brand-pink ring
     on focus. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_tile_surface"
    android:foreground="@drawable/bg_tile_focus"
    android:stateListAnimator="@animator/tile_focus"
    android:focusable="true"
    android:clickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_m">

        <ImageView
            android:id="@+id/cardIcon"
            android:layout_width="@dimen/badge_medium"
            android:layout_height="@dimen/badge_medium"
            android:background="@drawable/bg_badge_live"
            android:padding="@dimen/space_m"
            android:src="@drawable/ic_tv"
            android:tint="@color/text_primary"
            android:contentDescription="@string/nav_live" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="@dimen/space_s" />

        <TextView
            android:id="@+id/cardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/cardSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:gravity="start"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Decorative "open" affordance, top-right. -->
    <ImageView
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/space_m"
        android:src="@drawable/ic_arrow_right"
        android:tint="@color/text_muted"
        android:alpha="0.55"
        android:importantForAccessibility="no" />
</FrameLayout>
