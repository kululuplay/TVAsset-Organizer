<?xml version="1.0" encoding="utf-8"?>
<!-- ExoPlayer surface. Rendered through a TextureView (not the default
     SurfaceView) because several Android TV panels show a solid green frame with
     a hardware-overlay SurfaceView while audio plays fine. A TextureView routes
     frames through the GPU and avoids that overlay/color path. -->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit" />
