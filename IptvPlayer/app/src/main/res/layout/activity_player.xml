<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen playback. Video container fills the screen; the zapping overlay
     and buffering indicator sit on top. Overlay uses safe-area padding. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@android:color/black">

    <!-- Engine (ExoPlayer / VLC) attaches its surface here. -->
    <FrameLayout
        android:id="@+id/videoContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Never expose an unverified decoder surface. Some Android TV hardware
         renders green buffers while its format settles; the controller keeps
         this opaque cover visible until PixelCopy confirms a healthy frame. -->
    <View
        android:id="@+id/playbackCover"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="visible" />

    <!-- Branded buffering indicator -->
    <LinearLayout
        android:id="@+id/bufferingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="@color/brand_purple" />

        <TextView
            android:id="@+id/bufferingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/buffering"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:layout_marginTop="@dimen/space_s" />
    </LinearLayout>

    <!-- Reconnect-failed overlay: shown only when the bounded auto-reconnect
         window elapses with no recovery. Offers a manual retry of the same
         channel. Stays hidden while reconnect attempts are still in flight. -->
    <LinearLayout
        android:id="@+id/errorOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingHorizontal="@dimen/space_l"
        android:paddingVertical="@dimen/space_m"
        android:background="@drawable/bg_zap_banner"
        android:visibility="gone">

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/error_cannot_connect"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:gravity="center" />

        <Button
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/action_retry"
            android:textColor="@color/text_primary"
            android:layout_marginTop="@dimen/space_m"
            android:focusable="true"
            android:focusableInTouchMode="true" />
    </LinearLayout>

    <!-- Zapping / info overlay -->
    <LinearLayout
        android:id="@+id/infoOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/zap_banner_height"
        android:layout_gravity="bottom"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_zap_banner"
        android:layout_marginStart="@dimen/safe_area_h"
        android:layout_marginEnd="@dimen/safe_area_h"
        android:layout_marginBottom="@dimen/safe_area_v"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingVertical="@dimen/space_s"
        android:visibility="gone">

        <ImageView
            android:id="@+id/overlayLogo"
            android:layout_width="@dimen/zap_banner_logo"
            android:layout_height="@dimen/zap_banner_logo"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/space_m"
            android:contentDescription="@string/now_playing" />

        <TextView
            android:id="@+id/overlayNumber"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/brand_pink"
            android:textSize="@dimen/zap_text_number"
            android:textStyle="bold"
            android:minWidth="@dimen/zap_number_min_width"
            android:gravity="center"
            android:layout_marginEnd="@dimen/space_m" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/overlayName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/zap_text_title"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/overlayCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/zap_text_secondary"
                android:layout_marginTop="@dimen/space_xs" />

            <TextView
                android:id="@+id/overlayNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/zap_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone" />

            <!-- How far we are into the current programme. -->
            <ProgressBar
                android:id="@+id/epgProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/zap_progress_height"
                android:max="100"
                android:progressDrawable="@drawable/progress_now"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone" />

            <!-- Start time · time left · end time. -->
            <LinearLayout
                android:id="@+id/epgTimes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:baselineAligned="false"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone">

                <TextView
                    android:id="@+id/overlayStart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/zap_text_secondary" />

                <TextView
                    android:id="@+id/overlayRemain"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:textColor="@color/brand_pink"
                    android:textStyle="bold"
                    android:textSize="@dimen/zap_text_secondary" />

                <TextView
                    android:id="@+id/overlayEnd"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/zap_text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/overlayNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/zap_text_secondary"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="@dimen/space_xs"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Diagnostics overlay (resolution / codec / fps / bitrate) -->
    <TextView
        android:id="@+id/statsOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="@dimen/safe_area_v"
        android:padding="@dimen/space_m"
        android:background="@drawable/bg_zap_banner"
        android:fontFamily="monospace"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_body"
        android:lineSpacingExtra="2dp"
        android:visibility="gone" />

    <!-- Debug overlay: engine/stage/resolution + live PlaybackLog tail. Gated by
         the Debug setting; sits top|end so it never collides with statsOverlay. -->
    <TextView
        android:id="@+id/debugOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="@dimen/safe_area_v"
        android:padding="@dimen/space_m"
        android:background="@drawable/bg_zap_banner"
        android:fontFamily="monospace"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_caption"
        android:lineSpacingExtra="1dp"
        android:visibility="gone" />
</FrameLayout>
