<?xml version="1.0" encoding="utf-8"?>
<!-- Left-column guide channel row: number + name + lazily-loaded "now" line.
     Focusable so D-pad focus drives the timeline on the right. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card_selectable"
    android:focusable="true"
    android:focusableInTouchMode="false"
    android:padding="@dimen/space_s"
    android:layout_marginBottom="@dimen/space_xs">

    <TextView
        android:id="@+id/channelNumber"
        android:layout_width="40dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/text_caption" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/channelName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/channelNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_caption"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
