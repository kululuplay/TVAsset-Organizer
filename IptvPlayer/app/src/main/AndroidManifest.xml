<?xml version="1.0" encoding="utf-8"?>
<!--
  IPTV Player manifest.
  - Declares it as a Leanback (TV) app but keeps leanback NOT required so it
    also installs on cheap sticks / phones.
  - Touchscreen not required (D-pad only devices).
  - SplashActivity is the launcher; it routes to Wizard / Login / Home.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Read Wi-Fi RSSI to grade the dashboard signal chip. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- In-app updates: download + install the latest APK from GitHub Releases. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- TV apps must not require a touchscreen. -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- Allow install on sticks/phones that lack full leanback. -->
    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />

    <application
        android:name=".IptvApp"
        android:allowBackup="true"
        android:banner="@drawable/app_banner"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IptvPlayer"
        android:usesCleartextTraffic="true">

        <!-- Launcher: branded splash, routes onward. -->
        <activity
            android:name=".ui.splash.SplashActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <!-- Standard launcher (phones/sticks). -->
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- TV home screen launcher. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run setup wizard. -->
        <activity
            android:name=".ui.wizard.WizardActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.login.LoginActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Post-login launcher dashboard. -->
        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Live player (ExoPlayer primary, libVLC fallback). -->
        <activity
            android:name=".ui.player.PlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="landscape" />

        <!-- On-demand player (VOD / series episodes) with resume + tracks. -->
        <activity
            android:name=".ui.player.VodPlayerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="landscape" />

        <!-- In-app trailer player (YouTube IFrame in a WebView). -->
        <activity
            android:name=".ui.trailer.TrailerActivity"
            android:exported="false"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout"
            android:screenOrientation="landscape" />

        <!-- EPG / TV guide. -->
        <activity
            android:name=".ui.guide.GuideActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.guide.EpgMappingActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Movies (VOD). -->
        <activity
            android:name=".ui.vod.VodActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.vod.VodDetailActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Series. -->
        <activity
            android:name=".ui.series.SeriesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.series.SeriesDetailActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Global search (Live + Movies + Series). -->
        <activity
            android:name=".ui.search.SearchActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Settings + sub-screens. -->
        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.settings.AboutActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.profiles.ProfilesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.account.AccountActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
        <activity
            android:name=".ui.diagnostics.DiagnosticsActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Catch-up / timeshift TV. -->
        <activity
            android:name=".ui.catchup.CatchupActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Continue Watching (in-progress movies/episodes). -->
        <activity
            android:name=".ui.dashboard.ContinueWatchingActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Unified Favorites (channels, movies and series). -->
        <activity
            android:name=".ui.favorites.FavoritesActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Content manager hub (Live / Movies / Series). -->
        <activity
            android:name=".ui.content.ContentManagerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Category manager (hide / reorder categories per content type). -->
        <activity
            android:name=".ui.content.CategoryManagerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Channel manager (hide / reorder / favorites). -->
        <activity
            android:name=".ui.channels.ChannelManagerActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Idle screensaver (burn-in protection). -->
        <activity
            android:name=".ui.screensaver.ScreensaverActivity"
            android:exported="false"
            android:screenOrientation="landscape" />

        <!-- Chromecast: register the options provider for the Cast framework. -->
        <meta-data
            android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
            android:value="com.iptv.player.cast.CastOptionsProvider" />

        <!-- FileProvider used to hand downloaded update APKs to the installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
